<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Activity"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:suite="sap.suite.ui.commons"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <VBox class="sapUiSmallMargin sapUiSizeCompact" width="100%">
                
                <!-- ==================== KEY METRICS CARDS ==================== -->
                <Panel 
                    headerText="Trip Analysis Dashboard"
                    class="sapUiNoContentPadding sapUiTinyMarginBottom">
                    <content>
                        <layout:Grid 
                            defaultSpan="L4 M4 S12" 
                            hSpacing="0.5rem" 
                            vSpacing="0.5rem"
                            class="sapUiSmallMargin">
                    
                    <layout:content>
                        <Panel 
                            class="metricCard sapUiTinyMarginBegin sapUiTinyMarginEnd"
                            headerText="Total TAT">
                            <content>
                                <VBox alignItems="Center" justifyContent="Center" class="metricCardContent">
                                    <core:Icon 
                                        src="sap-icon://time-entry-record"
                                        size="3rem"
                                        color="#0070f2"
                                        class="sapUiTinyMarginBottom"/>
                                    <Title 
                                        text="{activityModel>/tatText}"
                                        level="H2"
                                        class="metricValue"/>
                                    <Text 
                                        text="Total Turnaround Time"
                                        class="sapUiSmallFontSize sapUiTinyMarginTop metricLabel"/>
                                </VBox>
                            </content>
                        </Panel>
                    </layout:content>
                    
                    <layout:content>
                        <Panel 
                            class="metricCard sapUiTinyMarginBegin sapUiTinyMarginEnd"
                            headerText="Total Events">
                            <content>
                                <VBox alignItems="Center" justifyContent="Center" class="metricCardContent">
                                    <core:Icon 
                                        src="sap-icon://activities"
                                        size="3rem"
                                        color="#107e3e"
                                        class="sapUiTinyMarginBottom"/>
                                    <Title 
                                        text="{activityModel>/eventsCount}"
                                        level="H2"
                                        class="metricValue"/>
                                    <Text 
                                        text="Events Recorded"
                                        class="sapUiSmallFontSize sapUiTinyMarginTop metricLabel"/>
                                </VBox>
                            </content>
                        </Panel>
                    </layout:content>
                    
                    <layout:content>
                        <Panel 
                            class="metricCard sapUiTinyMarginBegin sapUiTinyMarginEnd"
                            headerText="Last Event">
                            <content>
                                <VBox alignItems="Center" justifyContent="Center" class="metricCardContent">
                                    <core:Icon 
                                        src="sap-icon://history"
                                        size="3rem"
                                        color="#e9730c"
                                        class="sapUiTinyMarginBottom"/>
                                    <Title 
                                        text="{activityModel>/lastUpdatedText}"
                                        level="H2"
                                        class="metricValue metricValueText"
                                        wrapping="true"/>
                                    <Text 
                                        text="Most Recent Activity"
                                        class="sapUiSmallFontSize sapUiTinyMarginTop metricLabel"/>
                                </VBox>
                            </content>
                        </Panel>
                    </layout:content>
                        </layout:Grid>
                    </content>
                </Panel>

                <!-- ==================== STAGE SUMMARY PANEL ==================== -->
                <Panel 
                    headerText="Stage Summary"
                    class="sapUiNoContentPadding sapUiTinyMarginTop"
                    expandable="true"
                    expanded="true">
                    <content>
                        <List
                            class="sapUiNoContentPadding"
                            items="{activityModel>/milestones}">
                            <CustomListItem 
                                class="sapUiTinyMargin"
                                type="Active">
                                <HBox alignItems="Center" class="sapUiSmallMargin">
                                    <core:Icon 
                                        src="{activityModel>icon}"
                                        size="2rem"
                                        class="sapUiTinyMarginEnd stageIcon"/>
                                    <VBox class="sapUiTinyMarginBegin" flex="1">
                                        <Title 
                                            text="{activityModel>title}"
                                            level="H6"
                                            class="sapUiTinyMarginBottom"/>
                                        <Text 
                                            text="{activityModel>description}"
                                            class="sapUiSmallFontSize"/>
                                    </VBox>
                                    <ObjectStatus
                                        text="{activityModel>tatText}"
                                        state="{activityModel>infoState}"
                                        class="sapUiTinyMarginBegin"/>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </content>
                </Panel>

                <!-- ==================== ACTIVITY TIMELINE PANEL ==================== -->
                <Panel 
                    headerText="Activity Timeline"
                    class="sapUiNoContentPadding sapUiTinyMarginTop"
                    expandable="true"
                    expanded="true">
                    <content>
                        <VBox class="sapUiSmallMargin" style="padding-left: 0.25rem;">
                            <suite:ProcessFlow
                                id="activityProcessFlow"
                                wheelZoomable="false"
                                foldedCorners="false"
                                zoomLevel="Three"
                                height="450px"
                                nodes="{activityModel>/nodes}"
                                lanes="{activityModel>/lanes}">

                                <suite:nodes>
                                    <suite:ProcessFlowNode
                                        nodeId="{activityModel>id}"
                                        laneId="{activityModel>laneId}"
                                        title="{activityModel>title}"
                                        state="{activityModel>state}"
                                        stateText="{activityModel>stateText}"
                                        text1="{activityModel>text1}"
                                        text2="{activityModel>text2}"
                                        icon="{activityModel>icon}"
                                        iconShape="{activityModel>iconShape}"
                                        children="{activityModel>children}"
                                        highlighted="{activityModel>highlighted}"
                                        focused="{activityModel>focused}"
                                        templateShareable="false"/>
                                </suite:nodes>

                                <suite:lanes>
                                    <suite:ProcessFlowLaneHeader
                                        laneId="{activityModel>id}"
                                        position="{activityModel>position}"
                                        icon="{activityModel>icon}"
                                        text="{activityModel>text}"
                                        templateShareable="false"/>
                                </suite:lanes>

                            </suite:ProcessFlow>
                        </VBox>
                    </content>
                </Panel>

                <!-- ==================== EVENTS DETAILS WITH ICONS ==================== -->
                <Panel 
                    headerText="Event Details"
                    class="sapUiTinyMarginTop sapUiNoContentPadding"
                    expandable="true"
                    expanded="true">
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <ScrollContainer
                                horizontal="false"
                                vertical="true"
                                width="100%"
                                height="500px"
                                class="sapUiNoContentPadding">
                                <List
                                    id="activityDetailsList"
                                    items="{activityModel>/events}"
                                    class="sapUiNoContentPadding">
                                    <CustomListItem class="eventDetailItem">
                                        <VBox class="sapUiSmallMargin">
                                            <!-- Event Header Row -->
                                            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                                <!-- Stage Icon -->
                                                <core:Icon 
                                                    src="{activityModel>_icon}"
                                                    size="2.5rem"
                                                    color="#0070f2"
                                                    class="sapUiTinyMarginEnd"/>
                                                <VBox class="sapUiTinyMarginBegin" flex="1">
                                                    <!-- Stage Title (consistent with Activity Timeline) -->
                                                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                                        <Title 
                                                            text="{activityModel>stageTitle}"
                                                            level="H4"
                                                            class="sapUiTinyMarginEnd"
                                                            style="color: #dc2626; font-weight: 700;"/>
                                                        <core:Icon 
                                                            src="sap-icon://detail-view"
                                                            size="1rem"
                                                            color="#666"
                                                            class="sapUiTinyMarginEnd"/>
                                                        <Text 
                                                            text="{activityModel>eventDescription}"
                                                            class="sapUiSmallFontSize"
                                                            wrapping="true"/>
                                                    </HBox>
                                                    <!-- Movement Type - Movement Scenario (consistent format with Stage Summary and Activity Timeline) -->
                                                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                                        <core:Icon 
                                                            src="sap-icon://arrow-right"
                                                            size="1rem"
                                                            color="#107e3e"
                                                            class="sapUiTinyMarginEnd"/>
                                                        <Text 
                                                            text="{activityModel>loadingUnloadingText}"
                                                            class="sapUiSmallFontSize"
                                                            wrapping="false"
                                                            style="font-weight: 600;"/>
                                                        <Text 
                                                            text=" - "
                                                            class="sapUiSmallFontSize sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                                                        <Text 
                                                            text="{activityModel>movementTypeDesc}"
                                                            class="sapUiSmallFontSize"
                                                            wrapping="false"/>
                                                        <Text 
                                                            text=" - "
                                                            class="sapUiSmallFontSize sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                                                        <Text 
                                                            text="{activityModel>movementScenarioDesc}"
                                                            class="sapUiSmallFontSize"
                                                            wrapping="true"/>
                                                        <!-- Show TAT inline if available -->
                                                        <Text 
                                                            text="{= ${activityModel>turnAroundTimeFormatted} !== '—' ? ' • TAT: ' + ${activityModel>turnAroundTimeFormatted} : ''}"
                                                            class="sapUiSmallFontSize sapUiTinyMarginBegin"
                                                            style="color: #107e3e; font-weight: 600;"/>
                                                    </HBox>
                                                </VBox>
                                            </HBox>
                                            
                                            <!-- Details Row with Icons -->
                                            <HBox alignItems="Start" wrap="Wrap" class="sapUiTinyMarginTop">
                                                <!-- TAT -->
                                                <HBox alignItems="Center" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                                    <core:Icon 
                                                        src="sap-icon://time-entry-record"
                                                        size="1rem"
                                                        color="#107e3e"
                                                        class="sapUiTinyMarginEnd"/>
                                                    <ObjectStatus
                                                        text="{activityModel>turnAroundTimeFormatted}"
                                                        state="Success"
                                                        class="sapUiSmallFontSize"/>
                                                </HBox>
                                                
                                                <!-- Timestamp -->
                                                <HBox alignItems="Center" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                                    <core:Icon 
                                                        src="sap-icon://calendar"
                                                        size="1rem"
                                                        color="#666"
                                                        class="sapUiTinyMarginEnd"/>
                                                    <Text 
                                                        text="{activityModel>displayTimestamp}"
                                                        class="sapUiSmallFontSize"
                                                        wrapping="false"/>
                                                </HBox>
                                                
                                                <!-- Created By -->
                                                <HBox alignItems="Center" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                                    <core:Icon 
                                                        src="sap-icon://employee"
                                                        size="1rem"
                                                        color="#666"
                                                        class="sapUiTinyMarginEnd"/>
                                                    <Text 
                                                        text="{activityModel>createdBy}"
                                                        class="sapUiSmallFontSize"
                                                        wrapping="false"/>
                                                </HBox>
                                            </HBox>
                                            
                                            <!-- Arrow Separator -->
                                            <HBox alignItems="Center" justifyContent="Center" class="sapUiSmallMarginTop">
                                                <core:Icon 
                                                    src="sap-icon://slim-arrow-down"
                                                    size="1.5rem"
                                                    color="#0070f2"
                                                    class="sapUiTinyMargin"/>
                                            </HBox>
                                        </VBox>
                                    </CustomListItem>
                                </List>
                            </ScrollContainer>
                        </VBox>
                    </content>
                </Panel>

    </VBox>
</mvc:View>

