<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Notes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
>
    <VBox class="sapUiSizeCompact sapUiTinyMargin">

        <!-- ========================================================= -->
        <!-- Add Note Section -->
        <!-- ========================================================= -->
        <Panel
            id="addNotePanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Add Note" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <TextArea
                    id="idNoteInput"
                    rows="4"
                    width="100%"
                    placeholder="Type your note here..."
                    class="sapUiTinyMarginBottom"
                />

                <HBox justifyContent="End" class="sapUiTinyMarginTop">
                    <Button
                        text="Save Note"
                        type="Accept"
                        icon="sap-icon://save"
                        press=".onSaveNote"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- Saved Notes Section -->
        <!-- ========================================================= -->
        <Panel
            id="savedNotesPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiTinyMarginTop"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Saved Notes" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <VBox class="noteVboxBG sapUiSmallPadding">
                    <FlexBox
                        id="idNotesContainer"
                        wrap="Wrap"
                        alignItems="Start"
                        justifyContent="Start"
                        class="notesContainer"
                    >
                        <Text
                            id="idNoNotesText"
                            text="No notes added yet."
                            visible="true"
                            class="sapUiTinyMargin"
                        />
                    </FlexBox>
                </VBox>
            </VBox>

        </Panel>

    </VBox>
</mvc:View>
