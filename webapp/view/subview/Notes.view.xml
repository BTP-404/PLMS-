<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Notes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ========================================================= -->
        <!-- Add Note Section -->
        <!-- ========================================================= -->
        <VBox class="sapUiMediumMargin">

            <Title text="Add Note" level="H5" class="sapUiTinyMarginBottom"/>

            <Text text="Write your note below:" class="sapUiTinyMarginBottom"/>

            <TextArea
                id="idNoteInput"
                rows="3"
                width="100%"
                placeholder="Type your note here..."
            />

            <HBox justifyContent="End" class="sapUiTinyMarginTop">
                <Button
                    text="Save Note"
                    type="Accept"
                    icon="sap-icon://save"
                    press=".onSaveNote"
                />
            </HBox>
        </VBox>

        <!-- ========================================================= -->
        <!-- Saved Notes Section -->
        <!-- ========================================================= -->
        <VBox class="sapUiMediumMargin">

            <Title text="Saved Notes" level="H5" class="sapUiTinyMarginBottom"/>

            <VBox class="sapUiSmallMargin noteVboxBG sapUiMediumPadding">
                <FlexBox
                    id="idNotesContainer"
                    wrap="Wrap"
                    alignItems="Start"
                    justifyContent="Start"
                    class="notesContainer"
                >
                    <Text
                        id="idNoNotesText"
                        text="No notes added yet."
                        visible="true"
                        class="sapUiTinyMargin"
                    />
                </FlexBox>
            </VBox>

        </VBox>

    </VBox>
</mvc:View>
