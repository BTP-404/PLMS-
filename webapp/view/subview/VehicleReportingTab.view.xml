<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.VehicleReportingTab"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact">
        <!-- ========================= SCANNER ROW ========================= -->
        <!-- Scanner Input and Button - Only visible for movement scenario I02 / ASN (see VehicleReportingTab.controller) -->
        <VBox 
            id="idReportingScannerVBox"
            class="sapUiSmallMarginBottom"
            visible="false">
            <Label
                text="Scanner Input"
                design="Bold"
                class="sapUiNoMarginBottom"
            />
            <HBox alignItems="Center" width="100%">
                <Input
                    id="idReportingScannerInput"
                    placeholder="Scan D-Note or enter PO number"
                    width="100%"
                    change="onScanLiveupdate"
                    
                    class="sapUiTinyMarginEnd"
                />
                <Button
                    id="idReportingScanButton"
                    text="Scan"
                    type="Emphasized"
                    icon="sap-icon://bar-code"
                    press="onScanSuccess"
                    class="sapUiTinyMarginBegin"
                />
            </HBox>
        </VBox>

        <Panel
            id="reportingDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Reporting Details" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>
            <VBox class="sapUiSizeCompact sapUiMediumPadding">
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- ================== COLUMN 1 ================== -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Movement Scenario"
                                design="Bold"
                                required="true"
                            />
                            <Select
                                id="idMovementScenario"
                                width="100%"
                                tooltip="Select movement scenario"
                                items="{movementScenarioItems>/}"
                                selectedKey="{path: 'TripData>/MovementScenarioItemKey', mode: 'TwoWay'}"
                                change="onMovementScenarioComboChange"
                                forceSelection="false"
                            >
                                <core:ListItem
                                    key="{movementScenarioItems>ItemKey}"
                                    text="{movementScenarioItems>LongText}"
                                    icon="{movementScenarioItems>Icon}"
                                />
                            </Select>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Movement Type"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idMovementType"
                                width="100%"
                                enabled="false"
                                value="{TripData>/MovementTypeDesc}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Vehicle Number"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idVehicleNumber"
                                width="100%"
                                showSuggestion="true"
                                suggestionItems="{vehicleNumberSuggestions>/items}"
                                suggest="onSuggest"
                                liveChange="onVehicleNumberLiveChange"
                                filterSuggests="false"
                                value="{TripData>/VehicleNumber}"
                                startSuggestion="1"
                                suggestionItemSelected="onSuggestionItemSelected"
                            >
                                <suggestionItems>
                                    <core:Item
                                        text="{vehicleNumberSuggestions>VehicleNumber}"
                                        additionalText="{vehicleNumberSuggestions>TransporterName}"
                                    />
                                </suggestionItems>
                                <customData>
                                    <core:CustomData
                                        key="field"
                                        value="vehicleNumber"
                                    />
                                </customData>
                            </Input>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Vehicle Type"
                                design="Bold"
                                required="true"
                            />
                            <ComboBox
                                id="idVehicleType"
                                width="100%"
                                items="{vehicleTypeSuggestions>/items}"
                                selectedKey="{TripData>/VehicleType}"
                                value="{TripData>/VehicleTypeDesc}"
                                filterSecondaryValues="false"
                                showSecondaryValues="false"
                                selectionChange="onVehicleTypeSelectionChange"
                                change="onVehicleTypeChange"
                            >
                                <core:ListItem
                                    key="{vehicleTypeSuggestions>ConfigID}"
                                    text="{vehicleTypeSuggestions>Description}"
                                />
                            </ComboBox>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Vehicle Size"
                                design="Bold"
                            />
                            <Input
                                id="idVehicleSize"
                                width="100%"
                                showSuggestion="true"
                                suggest="onVehicleSizeSuggest"
                                suggestionItemSelected="onVehicleSizeSuggestionSelected"
                                suggestionItems="{vehicleSizeSuggestions>/items}"
                                value="{TripData>/VehicleSize}"
                                editable="true"
                            >
                                <suggestionItems>
                                    <core:Item
                                        key="{vehicleSizeSuggestions>VehicleSize}"
                                        text="{vehicleSizeSuggestions>VehicleSize}"
                                        additionalText="{vehicleSizeSuggestions>VehicleSizeDesc}"
                                    />
                                </suggestionItems>
                            </Input>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Transporter Name"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idTransporterName"
                                width="100%"
                                value="{TripData>/TransporterName}"
                            />
                        </VBox>
                    </layout:content>
                    <!-- ================== COLUMN 2 ================== -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="LR Number"
                                design="Bold"
                            />
                            <Input
                                id="idLRNumber"
                                width="100%"
                                value="{TripData>/LR_Number}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="LR Date"
                                design="Bold"
                            />
                            <DatePicker
                                id="idLRDate"
                                width="100%"
                                value="{
                                    path: 'TripData>/LR_Date',
                                    formatter: '.formatLRDate'
                                }"
                                displayFormat="medium"
                                placeholder="{i18n>datePlaceholderExample}"
                                valueFormat="yyyy-MM-dd"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver Name"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idDriverName"
                                width="100%"
                                value="{TripData>/DriverName}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver Contact"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idDriverContact"
                                width="100%"
                                value="{TripData>/DriverMobile}"
                                type="Number"
                                liveChange=".onDriverContactLiveChange"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver License"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idDriverLicense"
                                width="100%"
                                value="{TripData>/DriverLicence}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver Photo"
                                design="Bold"
                            />
                            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                <unified:FileUploader
                                    id="idDriverPhotoUploader"
                                    name="driverPhoto"
                                    placeholder="Choose photo (JPG, PNG)"
                                    fileType="jpg,jpeg,png"
                                    icon="sap-icon://camera"
                                    width="70%"
                                    change=".onDriverPhotoChange"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="idPreviewDriverPhoto"
                                    icon="sap-icon://show"
                                    text="Preview"
                                    type="Transparent"
                                    press=".onPreviewDriverPhoto"
                                    visible="{= !!${TripData>/DriverPhoto}}"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                            <Image
                                id="idDriverPhotoPreview"
                                src="{TripData>/DriverPhoto}"
                                width="150px"
                                height="150px"
                                densityAware="false"
                                visible="{= !!${TripData>/DriverPhoto}}"
                                class="sapUiTinyMarginTop driverPhotoPreview"
                                press=".onPreviewDriverPhoto"
                            />
                        </VBox>
                    </layout:content>
                    <!-- ================== COLUMN 3 ================== -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Related Trip Number (Gate Pass No)"
                                design="Bold"
                            />
                            <Input
                                id="idRelatedTripNumber"
                                width="100%"
                                value="{
                                    path: 'TripData>/TripNumber',
                                    formatter: '.formatTripNumber'
                                }"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Additional Info"
                                design="Bold"
                            />
                            <TextArea
                                id="idAdditionalInfo"
                                width="100%"
                                growing="true"
                                value="{TripData>/AdditionalInfo}"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>
                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                    <Button
                        id="btnEditReporting"
                        text="Edit"
                        type="Emphasized"
                        press="onEditReporting"
                        icon="sap-icon://edit"
                    />
                    <Button
                        id="btnSaveReporting"
                        text="Save"
                        type="Accept"
                        press="onSaveReporting"
                        icon="sap-icon://save"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>
        <!-- ===================== CHANGE HISTORY ===================== -->
        <Panel
            id="changeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding"
            visible="false"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>
            <VBox
                class="sapUiSmallMargin sapUiMediumPadding sapUiSizeCompact"
                binding="{TripData>/}"
            >
                <HBox justifyContent="SpaceBetween">
                    <VBox width="48%">
                        <Label
                            text="Created By"
                            design="Bold"
                        />
                        <Input
                            id="idCreatedBy"
                            width="100%"
                            value="{TripData>/CreatedBy}"
                            enabled="false"
                        />
                    </VBox>
                    <VBox width="48%">
                        <Label
                            text="Created On Date"
                            design="Bold"
                        />
                        <Input
                            id="idCreatedOnDate"
                            width="100%"
                            value="{
                                path: 'TripData>/CreatedOn',
                                formatter: '.formatTripDate'
                            }"
                            enabled="false"
                        />
                    </VBox>
                </HBox>
                <VBox width="48%">
                    <Label
                        text="Created On Time"
                        design="Bold"
                    />
                    <Input
                        id="idCreatedOnTime"
                        width="100%"
                        value="{
                            path: 'TripData>/CreatedTime',
                            formatter: '.formatTripTime'
                        }"
                        enabled="false"
                    />
                </VBox>
            </VBox>
        </Panel>
    </VBox>
</mvc:View>
