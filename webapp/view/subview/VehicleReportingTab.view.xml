<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.VehicleReportingTab"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact sapUiSmallMargin">
        <Panel
            id="reportingDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Reporting Details" />
                </OverflowToolbar>
            </headerToolbar>
            <VBox class="sapUiSizeCompact sapUiMediumPadding">
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- ================== COLUMN 1 ================== -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Movement Scenario"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idMovementScenario"
                                width="100%"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpMovementScenario"
                                value="{TripData>/MovementScenario}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Movement Type"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idMovementType"
                                width="100%"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpMovementType"
                                enabled="false"
                                value="{TripData>/MovementType}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Vehicle Number"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idVehicleNumber"
                                width="100%"
                                showValueHelp="true"
                                showSuggestion="true"
                                suggestionItems="{VHModel>/}"
                                suggest=".onSuggest"
                                filterSuggests="false"
                                value="{TripData>/VehicleNumber}"
                                suggestThreshold="1"
                                valueHelpRequest=".onValueHelpVehicleNumber"
                                suggestionItemSelected=".onSuggestionItemSelected"
                            >
                                <suggestionItems>
                                    <core:Item
                                        text="{VHModel>VehicleNumber}"
                                        additionalText="{VHModel>TransporterName}"
                                    />
                                </suggestionItems>
                                <customData>
                                    <core:CustomData
                                        key="field"
                                        value="vehicleNumber"
                                    />
                                </customData>
                            </Input>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Vehicle Type"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idVehicleType"
                                width="100%"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpVehicleType"
                                value="{TripData>/VehicleType}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Vehicle Size"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idVehicleSize"
                                width="100%"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpVehicleSize"
                                value="{TripData>/VehicleSize}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Transporter Name"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idTransporterName"
                                width="100%"
                                value="{TripData>/TransporterName}"
                            />
                        </VBox>
                    </layout:content>
                    <!-- ================== COLUMN 2 ================== -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="LR Number"
                                design="Bold"
                            />
                            <Input
                                id="idLRNumber"
                                width="100%"
                                value="{TripData>/LR_Number}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="LR Date"
                                design="Bold"
                            />
                            <DatePicker
                                id="idLRDate"
                                width="100%"
                                value="{TripData>/LR_Date}"
                                displayFormat="long"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver Name"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idDriverName"
                                width="100%"
                                value="{TripData>/DriverName}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver Contact"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idDriverContact"
                                width="100%"
                                value="{TripData>/DriverMobile}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver License"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idDriverLicense"
                                width="100%"
                                value="{TripData>/DriverLicence}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Driver Photo"
                                design="Bold"
                            />
                            <unified:FileUploader
                                id="idDriverPhoto"
                                width="100%"
                                uploadUrl="/upload"
                                buttonText="Browse"
                                fileType="jpg,png"
                                placeholder="Upload Driver Photo"
                                change="onDriverPhotoChange"
                            />
                        </VBox>
                    </layout:content>
                    <!-- ================== COLUMN 3 ================== -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Plant"
                                design="Bold"
                                required="true"
                            />
                           <Input
    id="idPlant"
    width="100%"
    showValueHelp="true"
    valueHelpRequest="onValueHelpPlant"
    showSuggestion="true"
    suggest="onPlantSuggest"
    suggestionItems="{
        path: 'VHModel>/'
    }"
    value="{TripData>/Plant}"
    suggestionItemSelected="onPlantSuggestionSelected"
>
    <core:ListItem
        key="{VHModel>ConfigID}"
        text="{VHModel>ConfigID}"
        additionalText="{VHModel>Description}"
    />
</Input>

                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Company Code"
                                design="Bold"
                                required="true"
                            />
                            <Input
                                id="idCompanyCode"
                                width="100%"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpCompanyCode"
                                value="{TripData>/CompanyCode}"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Related Trip Number"
                                design="Bold"
                            />
                            <Input
                                id="idRelatedTripNumber"
                                width="100%"
                                value="{TripData>/TripNumber}"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox>
                            <Label
                                text="Additional Info"
                                design="Bold"
                            />
                            <TextArea
                                id="idAdditionalInfo"
                                width="100%"
                                growing="true"
                                value="{TripData>/AdditionalInfo}"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>
            </VBox>
        </Panel>
        <layout:Grid>
            <ToolbarSpacer/>
            <layout:content>
                <ToolbarSpacer/>
                <ToolbarSpacer/>
                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginTop sapUiSmallMarginEnd"
                >
                    <Button
                        id="btnEditReporting"
                        text="Edit"
                        type="Emphasized"
                        press="onEditReporting"
                        icon="sap-icon://edit"
                    />
                    <Button
                        id="btnSaveReporting"
                        text="Save"
                        type="Accept"
                        press="onSaveReporting"
                        icon="sap-icon://save"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </layout:content>
        </layout:Grid>
        <!-- ===================== CHANGE HISTORY ===================== -->
        <Panel
            id="changeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding"
            visible="false"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" />
                </OverflowToolbar>
            </headerToolbar>
            <VBox
                class="sapUiSmallMargin sapUiMediumPadding sapUiSizeCompact"
                binding="{TripData>/}"
            >
                <HBox justifyContent="SpaceBetween">
                    <VBox width="48%">
                        <Label
                            text="Created By"
                            design="Bold"
                        />
                        <Input
                            id="idCreatedBy"
                            width="100%"
                            value="{TripData>/CreatedBy}"
                            enabled="false"
                        />
                    </VBox>
                    <VBox width="48%">
                        <Label
                            text="Created On Date"
                            design="Bold"
                        />
                        <Input
                            id="idCreatedOnDate"
                            width="100%"
                            value="{TripData>/CreatedOn}"
                            enabled="false"
                        />
                    </VBox>
                </HBox>
                <VBox width="48%">
                    <Label
                        text="Created On Time"
                        design="Bold"
                    />
                    <Input
                        id="idCreatedOnTime"
                        width="100%"
                        value="{TripData>/CreatedTime}"
                        enabled="false"
                    />
                </VBox>
            </VBox>
        </Panel>
    </VBox>
</mvc:View>
