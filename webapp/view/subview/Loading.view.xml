<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Loading"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ===================== MATERIAL DETAILS PANEL ===================== -->
        <Panel
            id="materialDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Loading" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiSizeCompact">

                <!-- ===================== TABLE SECTION ===================== -->
                <ScrollContainer
                    horizontal="true"
                    vertical="false"
                    width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                        <Table
                            id="idLoadingMaterialTable"
                            inset="false"
                            width="auto"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{tableModel>/materials}"
                            noDataText="No materials loaded yet">
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6" />
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idLoadingColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onLoadingColumnSettings"/>
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column
                                    id="colLoadingRefDocNumber"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Ref Doc Number" />
                                </Column>
                                <Column
                                    id="colLoadingRefDocItemNumber"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Ref Doc Item Number" />
                                </Column>
                                <Column
                                    id="colLoadingMaterialCode"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Material Code" />
                                </Column>
                                <Column
                                    id="colLoadingMaterialDescription"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Material Description" />
                                </Column>
                                <Column
                                    id="colLoadingQty"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Qty" />
                                </Column>
                                <Column
                                    id="colLoadingUoM"
                                    hAlign="Center"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="UoM" />
                                </Column>
                                <Column
                                    id="colLoadingQtyConfirm"
                                    hAlign="Center"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Qty Confirmed" />
                                </Column>
                                <Column
                                    id="colLoadingLoadedWeight"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Loaded Quantity" />
                                </Column>
                                <Column
                                    id="colLoadingGrossWt"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{loadingModel>/weighmentEnabled}">
                                    <Text text="Gross Wt" />
                                </Column>
                                <Column
                                    id="colLoadingTareWt"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{loadingModel>/weighmentEnabled}">
                                    <Text text="Tare Wt" />
                                </Column>
                                <Column
                                    id="colLoadingNetWt"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{loadingModel>/weighmentEnabled}">
                                    <Text text="Net Wt" />
                                </Column>
                                <Column
                                    id="colLoadingRemark"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Remark" />
                                </Column>
                                <Column
                                    id="colLoadingCreatedBy"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Created By" />
                                </Column>
                                <Column
                                    id="colLoadingCreatedOnDate"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Created On Date" />
                                </Column>
                                <Column
                                    id="colLoadingCreatedOnTime"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Created On Time" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{tableModel>RefDocNumber}"/>
                                        <Text text="{tableModel>RefDocItemNumber}"/>
                                        <Text text="{tableModel>MaterialCode}"/>
                                        <Text text="{tableModel>MaterialDescription}"/>
                                        <Text 
                                            text="{tableModel>Qty}"
                                            textAlign="End"/>
                                        <Text 
                                            text="{tableModel>UoM}"
                                            textAlign="Center"/>
                                        <HBox justifyContent="Center" alignItems="Center">
                                            <CheckBox
                                                selected="{= ${tableModel>ConfirmQty} === 'X' }"
                                                select=".onConfirmQtySelect"
                                                tooltip="Confirm Quantity (backend field ConfirmQty)"
                                            />
                                        </HBox>
                                        <Input
                                            value="{tableModel>LoadedWeight}"
                                            enabled="true"
                                            placeholder="Enter Weight"
                                            width="8rem"
                                            type="Number"
                                            textAlign="End"
                                            class="sapUiSizeCompact"
                                            liveChange="onWeightFieldChange"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>GrossWt}"
                                            enabled="{loadingModel>/weighmentEnabled}"
                                            placeholder="Gross Wt"
                                            width="7rem"
                                            type="Number"
                                            textAlign="End"
                                            class="sapUiSizeCompact"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>TareWt}"
                                            enabled="{loadingModel>/weighmentEnabled}"
                                            placeholder="Tare Wt"
                                            width="7rem"
                                            type="Number"
                                            textAlign="End"
                                            class="sapUiSizeCompact"
                                            change="onWeightFieldChange"
                                        />
                                        <Text 
                                            text="{tableModel>NetWt}"
                                            textAlign="End"
                                            class="sapUiTinyMarginEnd"/>
                                        <Input
                                            value="{tableModel>Remark}"
                                            placeholder="Remark"
                                            width="10rem"
                                            maxLength="255"
                                            class="sapUiSizeCompact"
                                        />
                                        <Text text="{tableModel>CreatedBy}"/>
                                        <Text text="{tableModel>CreatedOnDate}"/>
                                        <Text text="{tableModel>CreatedOnTime}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                </ScrollContainer>

            </VBox>
        </Panel>

        <!-- ===================== BUTTONS AT BOTTOM ===================== -->
        <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
            <!-- Save Loading (weights/quantities/remark) -->
            <Button 
                id="btnSaveLoading" 
                text="Save" 
                type="Emphasized" 
                press="onSaveLoading" 
                icon="sap-icon://save"
            />

            <!-- Start Loading Button -->
            <Button 
                id="btnStartLoading" 
                text="Start Loading" 
                type="Accept" 
                press="onStartLoading" 
                icon="sap-icon://cart-3"
                class="sapUiTinyMarginBegin"
            />

            <!-- ReStart Loading Button (shown when loading is ended) -->
            <Button 
                id="btnReStartLoading" 
                text="ReStart Loading" 
                type="Accept" 
                press="onReStartLoading" 
                icon="sap-icon://refresh"
                visible="false"
                class="sapUiTinyMarginBegin"
            />

            <!-- End Loading Button -->
            <Button 
                id="btnEndLoading" 
                text="End Loading" 
                type="Reject" 
                press="onEndLoading" 
                icon="sap-icon://cart-5"
                class="sapUiTinyMarginBegin"
            />
        </HBox>

    </VBox>
</mvc:View>
