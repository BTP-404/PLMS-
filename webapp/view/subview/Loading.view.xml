<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Loading"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ===================== MATERIAL DETAILS PANEL ===================== -->
        <Panel
            id="materialDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Loading" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiSizeCompact">

                <!-- ===================== TABLE SECTION ===================== -->
                <ScrollContainer horizontal="true" vertical="false" width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                    <HBox wrap="Wrap" width="auto">
                        <Table
                            id="idLoadingMaterialTable"
                            inset="false"
                            mode="None"
                            width="100%"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{tableModel>/materials}"
                        >
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6" />
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idLoadingColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onLoadingColumnSettings"/>
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column
                                    id="colLoadingRefDocNumber"
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Ref Doc Number" />
                                </Column>
                                <Column
                                    id="colLoadingRefDocItemNumber"
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Ref Doc Item Number" />
                                </Column>
                                <Column
                                    id="colLoadingMaterialCode"
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                >
                                    <Text text="Material Code" />
                                </Column>
                                <Column
                                    id="colLoadingMaterialDescription"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Material Description" />
                                </Column>
                                <Column
                                    id="colLoadingQty"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                >
                                    <Text text="Qty" />
                                </Column>
                                <Column
                                    id="colLoadingUoM"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                >
                                    <Text text="UoM" />
                                </Column>
                                <Column
                                    id="colLoadingLoadedWeight"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Loaded Quantity" />
                                </Column>
                                <Column
                                    id="colLoadingGrossWt"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{loadingModel>/weighmentEnabled}"
                                >
                                    <Text text="Gross Wt" />
                                </Column>
                                <Column
                                    id="colLoadingTareWt"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{loadingModel>/weighmentEnabled}"
                                >
                                    <Text text="Tare Wt" />
                                </Column>
                                <Column
                                    id="colLoadingNetWt"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{loadingModel>/weighmentEnabled}"
                                >
                                    <Text text="Net Wt" />
                                </Column>
                                <Column
                                    id="colLoadingRemark"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Remark" />
                                </Column>
                                <Column
                                    id="colLoadingCreatedBy"
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                >
                                    <Text text="Created By" />
                                </Column>
                                <Column
                                    id="colLoadingCreatedOnDate"
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Created On Date" />
                                </Column>
                                <Column
                                    id="colLoadingCreatedOnTime"
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Created On Time" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{tableModel>RefDocNumber}"/>
                                        <Text text="{tableModel>RefDocItemNumber}"/>
                                        <Text text="{tableModel>MaterialCode}"/>
                                        <Text text="{tableModel>MaterialDescription}"/>
                                        <Text text="{tableModel>Qty}"/>
                                        <Text text="{tableModel>UoM}"/>
                                        <Input
                                            value="{tableModel>LoadedWeight}"
                                            enabled="{loadingModel>/weighmentEnabled}"
                                            placeholder="Enter Loaded Weight"
                                            width="100%"
                                            type="Number"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>GrossWt}"
                                            enabled="{loadingModel>/weighmentEnabled}"
                                            placeholder="Enter Gross Wt"
                                            width="100%"
                                            type="Number"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>TareWt}"
                                            enabled="{loadingModel>/weighmentEnabled}"
                                            placeholder="Enter Tare Wt"
                                            width="100%"
                                            type="Number"
                                            change="onWeightFieldChange"
                                        />
                                        <Text text="{tableModel>NetWt}"/>
                                        <Input
                                            value="{tableModel>Remark}"
                                            placeholder="Remark"
                                            width="100%"
                                            maxLength="255"
                                        />
                                        <Text text="{tableModel>CreatedBy}"/>
                                        <Text text="{tableModel>CreatedOnDate}"/>
                                        <Text text="{tableModel>CreatedOnTime}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </HBox>
                </ScrollContainer>

            </VBox>
        </Panel>

        <!-- ===================== BUTTONS AT BOTTOM ===================== -->
        <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
            <!-- Update Weights Button (only visible when weighment is enabled) -->
            <Button 
                id="btnUpdateWeights" 
                text="Save" 
                type="Emphasized" 
                press="onUpdateWeights" 
                icon="sap-icon://save"
                visible="{loadingModel>/weighmentEnabled}"
                class="sapUiTinyMarginEnd"
            />
            
            <!-- Start Loading / Restart Loading Button -->
            <Button 
                id="btnStartLoading" 
                text="Start Loading" 
                type="Accept" 
                press="onStartLoading" 
                icon="sap-icon://cart-3"
                enabled="true" 
            />

            <!-- End Loading Button -->
            <Button 
                id="btnEndLoading" 
                text="End Loading" 
                type="Reject" 
                press="onEndLoading" 
                icon="sap-icon://cart-5"
                enabled="false" 
                class="sapUiTinyMarginBegin"
            />
        </HBox>

    </VBox>
</mvc:View>
