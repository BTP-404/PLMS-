<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Loading"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ===================== MATERIAL DETAILS PANEL ===================== -->
        <Panel
            id="materialDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Loading" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiSizeCompact">

                <!-- ===================== TABLE SECTION ===================== -->
                <ScrollContainer horizontal="true" vertical="false" width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                    <HBox wrap="Wrap" width="auto">
                        <Table
                            id="idLoadingMaterialTable"
                            inset="false"
                            mode="None"
                            width="100%"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{tableModel>/materials}"
                            enabled="false"
                        >
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6" />
                                    <ToolbarSpacer />
                                    <Button
                                        id="btnAddRowLoading"
                                        text="Add Row"
                                        icon="sap-icon://add"
                                        type="Emphasized"
                                        press="onOpenAddRowDialog"
                                        enabled="false"
                                    />
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Ref Doc Number" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Ref Doc Item Number" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                >
                                    <Text text="Material Code" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Material Description" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                >
                                    <Text text="Qty" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                >
                                    <Text text="UoM" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Loaded Qty / Net Wt" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Gross Wt" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Tare Wt" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                >
                                    <Text text="Created By" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Created On Date" />
                                </Column>
                                <Column
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Created On Time" />
                                </Column>
                                <Column
                                    hAlign="Center"
                                    width="6rem"
                                >
                                    <Text text="Action" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{RefDocNumber}"/>
                                        <Text text="{RefDocItemNumber}"/>
                                        <Text text="{MaterialCode}"/>
                                        <Text text="{MaterialDescription}"/>
                                        <Text text="{Qty}"/>
                                        <Text text="{UoM}"/>
                                        <Text text="{LoadedQty}"/>
                                        <Text text="{GrossWt}"/>
                                        <Text text="{TareWt}"/>
                                        <Text text="{CreatedBy}"/>
                                        <Text text="{CreatedOnDate}"/>
                                        <Text text="{CreatedOnTime}"/>
                                        <Button 
                                            icon="sap-icon://delete" 
                                            type="Reject" 
                                            press=".onDeleteLoadingRow" 
                                            tooltip="Delete Row"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </HBox>
                </ScrollContainer>

            </VBox>
        </Panel>

        <!-- ===================== BUTTONS AT BOTTOM ===================== -->
        <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
            <!-- Start Loading Button -->
                    <Button 
                        id="btnStartLoading" 
                        text="Start Loading" 
                        type="Accept" 
                        press="onStartLoading" 
                        icon="sap-icon://cart-3"
                        enabled="true" 
                    />

                    <!-- End Loading Button -->
                    <Button 
                        id="btnEndLoading" 
                        text="End Loading" 
                        type="Reject" 
                        press="onEndLoading" 
                        icon="sap-icon://cart-5"
                        enabled="false" 
                        class="sapUiTinyMarginBegin"
                    />
        </HBox>

    </VBox>
</mvc:View>
