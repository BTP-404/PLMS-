<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.Stage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ========================================================= -->
        <!-- =============== Material Details Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="materialDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Material Details" />
                    <ToolbarSpacer />
                    <Button id="btnEditLoading" text="Edit" type="Emphasized" press="onEditLoading" icon="sap-icon://edit"/>
                    <Button id="btnSaveLoading" text="Save" type="Accept" press="onSaveLoading" icon="sap-icon://save" class="sapUiTinyMarginBegin"/>
                </OverflowToolbar>
            </headerToolbar>

            <!-- ===== Material Flags / Radio Buttons Section ===== -->
            <VBox class="sapUiSmallMargin sapUiSizeCompact">
                <layout:Grid defaultSpan="L12 M12 S12" width="100%">
                    <layout:content>
                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                            <Label text="Weighment Required?" width="15rem" design="Bold"/>
                            <RadioButtonGroup id="idWeighmentRequired" columns="2">
                                <buttons>
                                    <RadioButton text="Yes" key="Y"/>
                                    <RadioButton text="No" key="N"/>
                                </buttons>
                            </RadioButtonGroup>
                        </HBox>
                    </layout:content>
                </layout:Grid>

                <!-- ===== Table Section ===== -->
                <ScrollContainer horizontal="true" vertical="false" width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                    <HBox wrap="Wrap" width="auto">
                        <Table
                            id="idLoadingMaterialTable"
                            inset="false"
                            mode="None"
                            sticky="ColumnHeaders"
                            width="150rem"
                            class="sapUiSizeCompact"
                        >
                            <columns>
                                <Column><Text text="Ref Doc Number"/></Column>
                                <Column><Text text="Ref Doc Item Number"/></Column>
                                <Column><Text text="Material Code"/></Column>
                                <Column><Text text="Material Description"/></Column>
                                <Column><Text text="Qty"/></Column>
                                <Column><Text text="UoM"/></Column>
                                <Column><Text text="Loaded Qty / Net Wt"/></Column>
                                <Column><Text text="Gross Wt"/></Column>
                                <Column><Text text="Tare Wt"/></Column>
                                <Column><Text text="Created By"/></Column>
                                <Column><Text text="Created On Date"/></Column>
                                <Column><Text text="Created On Time"/></Column>
                                <Column><Text text="Changed By"/></Column>
                                <Column><Text text="Changed On Date"/></Column>
                                <Column><Text text="Changed On Time"/></Column>
                                <Column hAlign="Center" width="6rem">
                                    <Text text="Action"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Select width="10rem"/>
                                        <Select width="10rem"/>
                                        <Input width="10rem"/>
                                        <Input width="12rem"/>
                                        <Input width="8rem" type="Number"/>
                                        <Select width="6rem"/>
                                        <Input width="10rem"/>
                                        <Input width="8rem"/>
                                        <Input width="8rem"/>
                                        <Select width="10rem"/>
                                        <DatePicker width="10rem" displayFormat="short"/>
                                        <TimePicker width="10rem"/>
                                        <Select width="10rem"/>
                                        <DatePicker width="10rem" displayFormat="short"/>
                                        <TimePicker width="10rem"/>
                                        <Button icon="sap-icon://delete" type="Reject" press=".onDeleteLoadingRow" tooltip="Delete Row"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </HBox>
                </ScrollContainer>

                <!-- Add Row Button -->
                <HBox justifyContent="End" class="sapUiTinyMarginTop">
                    <Button
                        id="btnAddRowLoading"
                        text="Add Row"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press="onAddLoadingRow"
                    />
                </HBox>

            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- =============== Change History Panel ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="loadingChangeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiMediumPadding sapUiSizeCompact">
                <HBox fitContainer="true" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                    <VBox width="48%" class="sapUiTinyMarginEnd">
                        <Label text="Created By" design="Bold"/>
                        <Select id="idloadingCreatedBy" enabled="false" width="100%"/>
                    </VBox>

                    <VBox width="48%">
                        <Label text="Created On Date" design="Bold"/>
                        <DatePicker id="idloadingCreatedOnDate" enabled="false" width="100%"/>
                    </VBox>
                </HBox>

                <VBox width="48%">
                    <Label text="Created On Time" design="Bold"/>
                    <TimePicker id="idloadingCreatedOnTime" enabled="false" width="100%"/>
                </VBox>
            </VBox>

        </Panel>

    </VBox>
</mvc:View>
