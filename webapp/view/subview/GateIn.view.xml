<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    controllerName="com.incresolZ_INC_PLMS.controller.Stage"
    displayBlock="true"
>

    <VBox class="sapUiSizeCompact sapUiSmallMargin">

        <!-- ========================================================= -->
        <!-- =================== Gate In Info Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInInfoPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >

            <!-- ======= HEADER TOOLBAR (Title + Edit + Save) ========= -->
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate In Info" />
                    <ToolbarSpacer />
                    <Button
                        id="btnEditGateInInfo"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateInInfo"
                    />
                    <Button
                        id="btnSaveGateInInfo"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateInInfo"
                        class="sapUiTinyMarginBegin"
                    />
                </OverflowToolbar>
            </headerToolbar>

            <!-- ================= FORM BODY =================== -->
            <VBox class="sapUiSizeCompact">
                <HBox justifyContent="SpaceAround" alignItems="Start" width="100%">

                    <!-- ================== Column 1 ================== -->
                    <VBox width="33%" class="sapUiNoContentPadding">
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                        >
                            <Label text="Entry Gate Number" required="true" design="Bold" />
                            <Select id="idEntryGateNumber" required="true" />

                            <Label text="Delay Reasons" design="Bold" />
                            <Select id="idDelayReasons" />
                        </form:SimpleForm>
                    </VBox>

                    <!-- ================== Column 2 ================== -->
                    <VBox width="33%" class="sapUiNoContentPadding">
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                        >
                            <Label text="Remarks" design="Bold" />
                            <TextArea id="idGateInRemarks" rows="4" placeholder="Enter any remarks" />
                        </form:SimpleForm>
                    </VBox>

                    <!-- ================== Column 3 (EMPTY / FUTURE FIELDS) ================== -->
                    <VBox width="33%" class="sapUiNoContentPadding">
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                        >
                            <!-- Keep empty for now or add future inputs -->
                        </form:SimpleForm>
                    </VBox>

                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInChangeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiMediumPadding sapUiSizeCompact">
                <Title text="Change History" level="H5" class="sapUiSmallMarginBottom" />

                <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                    <VBox width="48%">
                        <Label text="Created By" design="Bold" />
                        <Select id="idGateInCreatedBy" enabled="false" width="100%" />
                    </VBox>

                    <VBox width="48%">
                        <Label text="Created On Date" design="Bold" />
                        <DatePicker id="idGateInCreatedOnDate" enabled="false" width="100%" />
                    </VBox>
                </HBox>

                <VBox width="48%">
                    <Label text="Created On Time" design="Bold" />
                    <TimePicker id="idGateInCreatedOnTime" enabled="false" width="100%" />
                </VBox>
            </VBox>
        </Panel>

    </VBox>
</mvc:View>
