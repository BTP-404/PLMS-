<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateIn"
    displayBlock="true"
>
    <VBox
        class="sapUiSizeCompact sapUiTinyMargin"
        width="100%"
    >
        <!-- ========================================================= -->
        <!-- =================== Gate In Info Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInInfoPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-In" />
                </OverflowToolbar>
            </headerToolbar>

         
                <!-- ========================= ROW 1 ========================= -->
                <!-- Entry Gate + Delay Reason -->
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                >
                    <!-- Entry Gate Number -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Entry Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idEntryGateNumber"
                                showValueHelp="true"
                                placeholder="Select Entry Gate"
                                valueHelpRequest="onEntryGateValueHelp"
                                width="100%"
                                value="{
                                    path: 'TripData>/EntryGateNum',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Delay Reason -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Delay Reasons"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idDelayReasons"
                                showValueHelp="true"
                                placeholder="Select Delay Reason"
                                valueHelpRequest="onDelayReasonValueHelp"
                                width="100%"
                                value="{
                                    path: 'TripData>/DelayReasonDesc',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 2 ========================= -->
                <!-- Weighment Required Radio Button -->
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Weighment Required"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idWeighmentRequired"
                                columns="2"
                                selectedIndex="{path: 'TripData>/WeighmentRequired', formatter: '.formatWeighmentRequiredIndex'}"
                                select="onWeighmentRequiredChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 3 ========================= -->
                <!-- Remarks full-width responsive -->
                <layout:Grid
                    defaultSpan="L8 M12 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateInRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                width="100%"
                                value="{
                                    path: 'TripData>/DelayRemarks',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiTinyMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateInInfo"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateInInfo"
                    />
                    <Button
                        id="btnSaveGateInInfo"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateInInfo"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
           
        </Panel>

