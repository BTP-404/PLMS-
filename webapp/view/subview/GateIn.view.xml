<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateIn"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact" width="100%">
            <!-- ========================================================= -->
            <!-- =================== Reporting (merged) =================== -->
            <!-- ========================================================= -->
            <mvc:XMLView viewName="com.incresolZ_INC_PLMS.view.subview.VehicleReportingTab" class="sapUiTinyMarginBottom"/>

            <!-- ========================================================= -->
            <!-- =============== Reference Documents (merged) ============= -->
            <!-- ========================================================= -->
            <mvc:XMLView
                id="idRefDocsViewGateIn"
                viewName="com.incresolZ_INC_PLMS.view.subview.ReferenceDocuments"
                class="sapUiTinyMarginBottom"
            />

            <!-- Gate-In and Change History: same margin as Reporting / Reference Documents -->
            <VBox class="sapUiSizeCompact" width="100%">
            <!-- ========================================================= -->
            <!-- =================== Gate In Info Panel ================== -->
            <!-- ========================================================= -->
            <Panel
                id="gateInInfoPanel"
                expandable="true"
                expanded="false"
                class="sapUiNoContentPadding sapUiTinyMarginBottom"
                width="100%"
                visible="{= !!String(${globalData>/TripNumber} || '').trim() }"
            >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-In" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding" width="100%">
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- Entry Gate Number -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Entry Gate Number"
                                required="true"
                                design="Bold"
                            />
                            <Select
                                id="idEntryGateNumber"
                                
                                
                                forceSelection="false"
                                selectedKey="{entryGateSelect>/SelectedProduct2}"
                                change="onEntryGateSelectChange"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Delay Reason -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Delay Reasons"
                                design="Bold"
                            />
                            <Select
                                id="idDelayReasons"
                               
                                forceSelection="false"
                                placeholder="Select Delay Reason"
                                selectedKey="{delayReasonSelect>/SelectedDelayKey}"
                                change="onDelayReasonSelectChange"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Gate Pass No (display only) -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Gate Pass No"
                                design="Bold"
                            />
                            <Input
                                id="idGateInRelatedTripNumber"
                                width="100%"
                                value="{
                                    path: 'TripData>/TripNumber',
                                    formatter: '.formatTripNumber'
                                }"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Bins Received -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Bins Received"
                                design="Bold"
                            />
                            <Input
                                id="idBinsReceived"
                                width="100%"
                                type="Number"
                                placeholder="Enter bins received"
                                value="{
                                    path: 'TripData>/BinsReceived',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Weighment Required -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Weighment Required"
                                design="Bold"
                            />
                            <RadioButtonGroup
                                id="idWeighmentRequired"
                                columns="2"
                                selectedIndex="{path: 'TripData>/WeighmentRequired', formatter: '.formatWeighmentRequiredIndex'}"
                                select="onWeighmentRequiredChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>

                    <!-- Skip Document (TripDetails RefDocSkip / GateIn RefdocSkip) -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Skip Document"
                                design="Bold"
                            />
                            <RadioButtonGroup
                                id="idSkipDocument"
                                columns="2"
                                selectedIndex="{path: 'TripData>/RefDocSkip', formatter: '.formatRefDocSkipIndex'}"
                                select="onRefDocSkipChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>

                    <!-- Remarks -->
                    <layout:content>
                        <VBox>
                            <layoutData>
                                <layout:GridData span="L8 M12 S12" />
                            </layoutData>
                            <Label
                                text="Remarks"
                                design="Bold"
                            />
                            <TextArea
                                id="idGateInRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                width="100%"
                                value="{
                                    path: 'TripData>/DelayRemarks',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Button row (same as Reporting section) -->
                <HBox justifyContent="End" class="sapUiSmallMarginTop" width="100%">
                    <Button
                        id="btnEditGateInInfo"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateInInfo"
                    />
                    <Button
                        id="btnSaveGateInInfo"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateInInfo"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel (at last) ========== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInChangeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox
                class="sapUiMediumPadding sapUiSizeCompact"
                width="100%"
            >
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    width="100%"
                    hSpacing="2"
                    vSpacing="2"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created By"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idGateInCreatedBy"
                                enabled="false"
                                width="100%"
                                value="{
                                    path: 'TripData>/CreatedBy',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created On Date"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <DatePicker
                                id="idGateInCreatedOnDate"
                                enabled="false"
                                width="100%"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="medium"
                                placeholder="{i18n>datePlaceholderExample}"
                                value="{
                                    path: 'TripData>/CreatedOn',
                                    formatter: '.formatTripDate'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created On Time"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TimePicker
                                id="idGateInCreatedOnTime"
                                enabled="false"
                                width="100%"
                                valueFormat="HH:mm:ss"
                                displayFormat="HH:mm:ss"
                                value="{
                                    path: 'TripData>/CreatedTime',
                                    formatter: '.formatTripTime'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>
            </VBox>
        </Panel>
        </VBox>
    </VBox>
</mvc:View>
