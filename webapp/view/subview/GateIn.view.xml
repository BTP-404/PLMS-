<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateIn"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact" width="100%">
            <!-- ========================================================= -->
            <!-- =================== Reporting (merged) =================== -->
            <!-- ========================================================= -->
            <mvc:XMLView
                id="idVehicleReportingEmbeddedGateIn"
                viewName="com.incresolZ_INC_PLMS.view.subview.VehicleReportingTab"
                class="sapUiTinyMarginBottom"
                visible="{= ${stageUi>/showReportingInGateOut} !== true }"
            />

            <!-- ========================================================= -->
            <!-- =============== Reference Documents (merged) ============= -->
            <!-- ========================================================= -->
            <mvc:XMLView
                id="idRefDocsViewGateIn"
                viewName="com.incresolZ_INC_PLMS.view.subview.ReferenceDocuments"
                class="sapUiTinyMarginBottom"
                visible="{gateInUi>/showPanels}"
            />

            <!-- Gate-In and Change History: same margin as Reporting / Reference Documents -->
            <VBox class="sapUiSizeCompact" width="100%">
            <!-- ========================================================= -->
            <!-- =============== Bin / Trolley Tracking Panel ============ -->
            <!-- (always before Gate-In panel) -->
            <!-- ========================================================= -->
        <Panel
            id="gateInBinTrolleyTrackingPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
            visible="{ui>/showBinTrolleyTracking}"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Bin / Trolley Tracking" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact" width="100%">
                <HBox justifyContent="End" class="sapUiTinyMarginBottom">
                    <Button
                        id="idAddBinTrolleyRowBtn"
                        text="Add Row"
                        icon="sap-icon://add"
                        type="Transparent"
                        press="onAddTrackingRow"
                        visible="{= !${globalData>/TripLocked} }"
                    />
                    <Button
                        id="idSaveBinTrolleyRowBtn"
                        text="Save"
                        icon="sap-icon://save"
                        type="Emphasized"
                        class="sapUiTinyMarginBegin"
                        press="onSaveTrackingRows"
                        visible="{= !${globalData>/TripLocked} }"
                    />
                </HBox>

                <Table
                    id="idGateInBinTrolleyTrackingTable"
                    width="100%"
                    fixedLayout="true"
                    autoPopin="true"
                    popinLayout="GridSmall"
                    items="{binTrolleyTracking>/items}"
                    class="sapUiSizeCompact binTrolleyTrackingTable plmsPanelDataTable"
                >
                    <columns>
                        <Column width="8rem" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                            <Text text="Doc No" />
                        </Column>
                        <Column width="6rem" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                            <Text text="Item" />
                        </Column>
                        <Column width="9rem" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                            <Text text="Part Code" />
                        </Column>
                        <Column width="12rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                            <Text text="Bin Type" />
                        </Column>
                        <Column hAlign="End" width="8rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                            <Text text="Qty Out" />
                        </Column>
                        <Column hAlign="Center" width="11rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                            <Text text="Qty In (Manual)" />
                        </Column>
                        <Column hAlign="End" width="9rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                            <Text text="Difference" />
                        </Column>
                        <Column hAlign="Center" width="11rem" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                            <Text text="Return Status" />
                        </Column>
                        <Column hAlign="Center" width="4rem" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                            <Text text="" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem class="binTrolleyTrackingRow">
                            <cells>
                                <Input value="{binTrolleyTracking>DocumentNumber}" editable="{= ${binTrolleyTracking>IsManual} &amp;&amp; !${globalData>/TripLocked} }" />
                                <Input value="{binTrolleyTracking>ItemNo}" editable="{= ${binTrolleyTracking>IsManual} &amp;&amp; !${globalData>/TripLocked} }" />
                                <Input
                                    value="{binTrolleyTracking>Material}"
                                    editable="{= ${binTrolleyTracking>IsManual} &amp;&amp; !${globalData>/TripLocked} }"
                                    change="onBinTrolleyPartCodeChange"
                                    showSuggestion="true"
                                    suggestionItems="{partCodeSuggest>/items}"
                                    suggest=".onBinTrolleyPartCodeSuggest"
                                    suggestionItemSelected=".onBinTrolleyPartCodeSuggestionSelected"
                                    filterSuggests="false"
                                    startSuggestion="1"
                                    class="binTrolleyPartCode"
                                >
                                    <suggestionItems>
                                        <core:Item
                                            text="{partCodeSuggest>PartCode}"
                                            additionalText="{partCodeSuggest>PartcodeDesc}"
                                            key="{= ${partCodeSuggest>PartCode} + '|' + ${partCodeSuggest>BinType} }"
                                        />
                                    </suggestionItems>
                                </Input>
                                <Input
                                    value="{binTrolleyTracking>BinTypeDesc}"
                                    editable="{= ${binTrolleyTracking>IsManual} &amp;&amp; !${globalData>/TripLocked} }"
                                    width="100%"
                                    tooltip="{binTrolleyTracking>BinTypeDesc}"
                                />
                                <ObjectNumber
                                    number="{binTrolleyTracking>QtyOut}"
                                    emphasized="false"
                                />
                                <Input
                                    value="{binTrolleyTracking>QtyIn}"
                                    placeholder="0"
                                    type="Text"
                                    valueLiveUpdate="true"
                                    textAlign="Center"
                                    width="6rem"
                                    editable="{= !${globalData>/TripLocked} }"
                                    valueState="{path: 'binTrolleyTracking>ReturnStatus', formatter: '.formatTrackingQtyValueState'}"
                                    showValueStateMessage="false"
                                    liveChange="onBinTrackingQtyInLiveChange"
                                    paste="onBinTrackingQtyInPaste"
                                    change="onTrackingFieldLiveChange"
                                />
                                <ObjectStatus
                                    text="{path: 'binTrolleyTracking>Difference', formatter: '.formatTrackingDifferenceText'}"
                                    state="{path: 'binTrolleyTracking>Difference', formatter: '.formatTrackingDifferenceState'}"
                                    class="binTrolleyDifference"
                                />
                                <ObjectStatus
                                    text="{binTrolleyTracking>ReturnStatus}"
                                    state="{path: 'binTrolleyTracking>ReturnStatus', formatter: '.formatTrackingStatusState'}"
                                />
                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    tooltip="Remove/Delete row"
                                    press="onRemoveTrackingRow"
                                    visible="{= !${globalData>/TripLocked} }"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <HBox justifyContent="End" class="sapUiTinyMarginTop binTrolleyTrackingTotalBar">
                    <Text
                        text="{path: 'binTrolleyTracking>/totalQtyOut', formatter: '.formatTrackingTotalQtyOutLine'}"
                        class="sapUiTinyMarginEnd binTrolleyTrackingTotalLabel"
                    />
                    <Text
                        text="{path: 'binTrolleyTracking>/totalQtyIn', formatter: '.formatTrackingTotalQtyInLine'}"
                        class="sapUiTinyMarginEnd binTrolleyTrackingTotalLabel"
                    />
                    <Text
                        text="{path: 'binTrolleyTracking>/totalReturnStatusSummary', formatter: '.formatTrackingTotalReturnStatusLine'}"
                        class="binTrolleyTrackingTotalDiff"
                    />
                </HBox>
            </VBox>
        </Panel>

            <!-- ========================================================= -->
            <!-- =================== Gate In Info Panel ================== -->
            <!-- ========================================================= -->
            <Panel
                id="gateInInfoPanel"
                expandable="true"
                expanded="false"
                class="sapUiNoContentPadding sapUiTinyMarginBottom"
                width="100%"
            visible="{gateInUi>/showPanels}"
            >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-In" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding" width="100%">
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- Entry Gate Number -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Entry Gate Number"
                                required="true"
                                design="Bold"
                            />
                            <Select
                                id="idEntryGateNumber"
                                selectedKey="{entryGateSelect>/SelectedProduct2}"
                                change="onEntryGateSelectChange"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Delay Reason -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Delay Reasons"
                                design="Bold"
                            />
                            <Select
                                id="idDelayReasons"
                               
                                forceSelection="false"
                                placeholder="Select Delay Reason"
                                selectedKey="{delayReasonSelect>/SelectedDelayKey}"
                                change="onDelayReasonSelectChange"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Gate Pass No (display only) -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Gate Pass No"
                                design="Bold"
                            />
                            <Input
                                id="idGateInRelatedTripNumber"
                                width="100%"
                                value="{
                                    path: 'TripData>/TripNumber',
                                    formatter: '.formatTripNumber'
                                }"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Skip Document (TripDetails RefDocSkip / GateIn RefdocSkip) -->
                    <layout:content>
                        <VBox>
                            <Label
                                text="Skip Document"
                                design="Bold"
                            />
                            <RadioButtonGroup
                                id="idSkipDocument"
                                columns="2"
                                selectedIndex="{path: 'TripData>/RefDocSkip', formatter: '.formatRefDocSkipIndex'}"
                                select="onRefDocSkipChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>

                    <!-- Remarks -->
                    <layout:content>
                        <VBox>
                            <layoutData>
                                <layout:GridData span="L8 M12 S12" />
                            </layoutData>
                            <Label
                                text="Remarks"
                                design="Bold"
                            />
                            <TextArea
                                id="idGateInRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                width="100%"
                                value="{
                                    path: 'TripData>/DelayRemarks',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Button row (same as Reporting section) -->
                <HBox justifyContent="End" class="sapUiSmallMarginTop" width="100%">
                    <Button
                        id="btnEditGateInInfo"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateInInfo"
                        visible="{= !${globalData>/TripLocked} }"
                    />
                    <Button
                        id="btnSaveGateInInfo"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateInInfo"
                        class="sapUiTinyMarginBegin"
                        visible="{= !${globalData>/TripLocked} }"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel (at last) ========== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInChangeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
            visible="{gateInUi>/showPanels}"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox
                class="sapUiMediumPadding sapUiSizeCompact"
                width="100%"
            >
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    width="100%"
                    hSpacing="2"
                    vSpacing="2"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created By"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idGateInCreatedBy"
                                enabled="false"
                                width="100%"
                                value="{
                                    path: 'TripData>/CreatedBy',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created On Date"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <DatePicker
                                id="idGateInCreatedOnDate"
                                enabled="false"
                                width="100%"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="medium"
                                placeholder="{i18n>datePlaceholderExample}"
                                value="{
                                    path: 'TripData>/CreatedOn',
                                    formatter: '.formatTripDate'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created On Time"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TimePicker
                                id="idGateInCreatedOnTime"
                                enabled="false"
                                width="100%"
                                valueFormat="HH:mm:ss"
                                displayFormat="HH:mm:ss"
                                value="{
                                    path: 'TripData>/CreatedTime',
                                    formatter: '.formatTripTime'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>
            </VBox>
        </Panel>
        </VBox>
    </VBox>
</mvc:View>
