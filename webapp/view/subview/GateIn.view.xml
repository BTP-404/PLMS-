<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateIn"
    displayBlock="true"
>
    <VBox
        class="sapUiSizeCompact sapUiSmallMargin"
        width="100%"
    >
        <!-- ========================================================= -->
        <!-- =================== Gate In Info Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInInfoPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-In " />
                </OverflowToolbar>
            </headerToolbar>

            <VBox
                class="sapUiSizeCompact "
                width="100%"
            >
                <!-- ========================= ROW 1 ========================= -->
                <!-- Entry Gate + Delay Reason -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    
                >
                    <!-- Entry Gate Number -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Entry Gate Number"
                                required="true"
                                design="Bold"
                            />
                            <Input
                                id="idEntryGateNumber"
                                showValueHelp="true"
                                placeholder="Select Entry Gate"
                                valueHelpRequest="onEntryGateValueHelp"
                                width="50%"
                               value="{LocalTripData>/EntryGateNum}"

                            />
                        </VBox>
                    </layout:content>

                    <!-- Delay Reason -->
                    <layout:content>
                        <VBox width="50%">
                            <Label
                                text="Delay Reasons"
                                design="Bold"
                            />
                            <Input
                                id="idDelayReasons"
                                showValueHelp="true"
                                placeholder="Select Delay Reason"
                                valueHelpRequest="onDelayReasonValueHelp"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 2 ========================= -->
                <!-- Remarks full-width responsive -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    
                >
                    <layout:content>
                        <VBox width="50%">
                            <Label
                                text="Remarks"
                                design="Bold"
                            />
                            <TextArea
                                id="idGateInRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginEnd"
                    width="100%"
                >
                    <Button
                        id="btnEditGateInInfo"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateInInfo"
                    />
                    <Button
                        id="btnSaveGateInInfo"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateInInfo"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInChangeHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Change History" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox
                class="sapUiSmallMargin sapUiMediumPadding sapUiSizeCompact"
                width="100%"
            >
                <Title
                    text="Change History"
                    level="H5"
                    class="sapUiSmallMarginBottom"
                />

                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    width="100%"
                    hSpacing="2"
                    vSpacing="2"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created By"
                                design="Bold"
                            />
                            <Select
                                id="idGateInCreatedBy"
                                enabled="false"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created On Date"
                                design="Bold"
                            />
                            <DatePicker
                                id="idGateInCreatedOnDate"
                                enabled="false"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <VBox width="48%">
                    <Label
                        text="Created On Time"
                        design="Bold"
                    />
                    <TimePicker
                        id="idGateInCreatedOnTime"
                        enabled="false"
                        width="100%"
                    />
                </VBox>
            </VBox>
        </Panel>
    </VBox>
</mvc:View>
