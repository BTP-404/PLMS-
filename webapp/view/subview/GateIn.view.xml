<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateIn"
    displayBlock="true"
>
    <VBox
        class="sapUiSizeCompact sapUiTinyMargin"
        width="100%"
    >
        <!-- ========================================================= -->
        <!-- =================== Gate In Info Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInInfoPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-In" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <!-- ========================= SCANNER ROW ========================= -->
                <!-- Scanner Input and Button -->
                <layout:Grid
                    defaultSpan="L6 M8 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginBottom"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Scanner Input"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <HBox alignItems="Center" width="100%">
                                <Input
                                    id="idGateInScannerInput"
                                    placeholder="Scan barcode or enter manually"
                                    width="100%"
                                    liveChange="onScanLiveupdate"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="idGateInScanButton"
                                    text="Scan"
                                    type="Emphasized"
                                    icon="sap-icon://bar-code"
                                    press="onScanSuccess"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 1 ========================= -->
                <!-- Entry Gate + Delay Reason + Upload Attachments -->
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                >
                    <!-- Entry Gate Number -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Entry Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idEntryGateNumber"
                                showValueHelp="true"
                                placeholder="Select Entry Gate"
                                valueHelpRequest="onEntryGateValueHelp"
                                width="100%"
                                value="{
                                    path: 'TripData>/EntryGateNum',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Delay Reason -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Delay Reasons"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idDelayReasons"
                                showValueHelp="true"
                                placeholder="Select Delay Reason"
                                valueHelpRequest="onDelayReasonValueHelp"
                                width="100%"
                                value="{
                                    path: 'TripData>/DelayReasonDesc',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Upload Attachments -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Upload Attachments"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <HBox alignItems="Center" width="100%">
                                <unified:FileUploader
                                    id="idGateInAttachments"
                                    multiple="true"
                                    buttonText="Choose Files"
                                    fileType="jpg,png,pdf,docx"
                                    placeholder="Attach related documents"
                                    change="onGateInAttachmentChange"
                                    width="100%"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="idPreviewSelectedGateInFiles"
                                    icon="sap-icon://show"
                                    tooltip="Preview Selected Files"
                                    type="Transparent"
                                    enabled="false"
                                    press="onPreviewSelectedGateInFiles"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 2 ========================= -->
                <!-- Weighment Required Radio Button -->
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Weighment Required"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idWeighmentRequired"
                                columns="2"
                                selectedIndex="{path: 'TripData>/WeighmentRequired', formatter: '.formatWeighmentRequiredIndex'}"
                                select="onWeighmentRequiredChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 3 ========================= -->
                <!-- Remarks full-width responsive -->
                <layout:Grid
                    defaultSpan="L8 M12 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateInRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                width="100%"
                                value="{
                                    path: 'TripData>/DelayRemarks',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiTinyMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateInInfo"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateInInfo"
                    />
                    <Button
                        id="btnSaveGateInInfo"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateInInfo"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Saved Attachments Panel =============== -->
        <!-- ========================================================= -->
        <Panel
            id="gateInAttachmentsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiTinyMarginTop"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate In Attachments" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <List
                    id="idGateInAttachmentsList"
                    mode="None"
                    noDataText="No attachments uploaded yet."
                    items="{gateInAttachmentsModel>/attachments}"
                    class="sapUiSizeCompact"
                >
                    <items>
                        <CustomListItem>
                            <HBox alignItems="Center" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                <core:Icon
                                    src="sap-icon://attachment"
                                    size="1.5rem"
                                    class="sapUiTinyMarginEnd"
                                    color="#0070f2"
                                />
                                <VBox class="sapUiTinyMarginBegin" flex="1">
                                    <Text
                                        text="{gateInAttachmentsModel>fileName}"
                                        class="sapUiTinyMarginBottom"
                                        wrapping="true"
                                    />
                                    <Text
                                        text="{gateInAttachmentsModel>contentType}"
                                        class="sapUiSmallFontSize"
                                        wrapping="true"
                                    />
                                </VBox>
                                <Button
                                    text="Preview"
                                    type="Emphasized"
                                    icon="sap-icon://show"
                                    press="onPreviewGateInAttachment"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </CustomListItem>
                    </items>
                </List>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
