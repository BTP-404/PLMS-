<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.ReferenceDocuments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <VBox class="sapUiSizeCompact" width="100%">

        <!-- ========================================================= -->
        <!-- =============== Reference Documents Panel =============== -->
        <!-- ========================================================= -->
        <Panel
            expandable="true"
            expanded="false"
            width="100%"
            class="sapUiNoContentPadding">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Reference Documents" class="sectionPanelTitle"/>
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding" width="100%">
                <ScrollContainer
                    horizontal="false"
                    vertical="false"
                    width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                        <Table
                            id="idReferenceDocsTable"
                            inset="false"
                            mode="SingleSelectMaster"
                            width="100%"
                            class="sapUiSizeCompact"
                            fixedLayout="true"
                            autoPopin="true"
                            popinLayout="GridSmall"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{path: 'refDocModel>/referenceDocs'}"
                            selectionChange="onRefDocSelectionChange"
                            noDataText="No reference documents added yet">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Reference Documents" level="H6"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idRefDocColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onRefDocColumnSettings"/>
                                    <Button
                                        id="idAddRefDocButton"
                                        text="Add Document"
                                        icon="sap-icon://add"
                                        type="Emphasized"
                                        press="onAddRefDocRow"
                                        visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }"/>
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colRefDocType" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                                    <Text text="Doc Type" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocNumber" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                                    <Text text="Document Number" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocDate" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Document Date" wrapping="false"/>
                                </Column>
                                <Column id="colEwayBillNumber" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Block" visible="true">
                                    <Text text="EWB No" wrapping="false"/>
                                </Column>
                                <Column id="colEwayBillDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Block" visible="true">
                                    <Text text="EWB Date" wrapping="false"/>
                                </Column>
                                <Column
                                    id="colInvRefNo"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Block">
                                    <Text text="Invoice Ref. No" wrapping="false"/>
                                </Column>
                                <Column
                                    id="colInvRefDate"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Block">
                                    <Text text="Invoice Document Date" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocPartyCode" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Block">
                                    <Text text="Party Code" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocPartyName" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Block">
                                    <Text text="Party Name" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocCreatedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created By" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocCreatedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Date" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocCreatedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Time" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocChangedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed By" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocChangedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Date" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocChangedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Time" wrapping="false"/>
                                </Column>
                                <Column id="colRefDocAction" hAlign="Center" width="12rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Action" wrapping="false"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{refDocModel>docType}"/>
                                        <Text text="{refDocModel>documentNumber}"/>
                                        <Text text="{refDocModel>documentDate}"/>
                                        <Text text="{refDocModel>ewayBillNumber}"/>
                                        <Text text="{path: 'refDocModel>ewayBillDate', formatter: '.formatEwayBillDate'}"/>
                                        <Text text="{refDocModel>invRefNo}"/>
                                        <Text text="{refDocModel>invRefDate}"/>
                                        <Text text="{refDocModel>partyCode}"/>
                                        <Text text="{refDocModel>partyName}"/>
                                        <Text text="{refDocModel>createdBy}"/>
                                        <Text text="{refDocModel>createdOnDate}"/>
                                        <Text text="{refDocModel>createdOnTime}"/>
                                        <Text text="{refDocModel>changedBy}"/>
                                        <Text text="{refDocModel>changedOnDate}"/>
                                        <Text text="{refDocModel>changedOnTime}"/>
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceAround"
                                            width="100%"
                                            visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }">
                                            <Button
                                                icon="sap-icon://list"
                                                type="Transparent"
                                                tooltip="Select Materials"
                                                press=".onSelectMaterialsFromTable"/>
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press=".onEditRefDocRow"/>
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press=".onDeleteRefDocRow"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                </ScrollContainer>
            </VBox>
        </Panel>



        <!-- ========================================================= -->
        <!-- =============== Material Details Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            expandable="true"
            expanded="false"
            width="100%"
            class="sapUiNoContentPadding sapUiSmallMarginTop">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Material Details" class="sectionPanelTitle"/>
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding" width="100%">
                <ScrollContainer
                    horizontal="false"
                    vertical="false"
                    width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                        <Table
                            id="idMaterialDetailsTable"
                            inset="false"
                            width="100%"
                            class="sapUiSizeCompact"
                            fixedLayout="true"
                            autoPopin="true"
                            popinLayout="GridSmall"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            items="{path: 'refDocModel>/filteredMaterialDetails'}"
                            noDataText="No material rows added yet">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idMaterialColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onMaterialColumnSettings"/>
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colMaterialCode" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                                    <Text text="Material Code" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialRefDocNo" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Ref Doc No" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialRefDocItemNo" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Ref Doc Item No" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialDescription" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Material Description" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialQuantity" hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Quantity" wrapping="false"/>
                                </Column>
                                <Column id="colDispatchQty" hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Dispatch Qty" wrapping="false"/>
                                </Column>
                                <Column id="colRemainQty" hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Remain Qty" wrapping="false"/>
                                </Column>
                                <Column id="colDispatchDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Dispatch Date" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialUoM" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="UoM" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialBinsTrolleys" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline" hAlign="End">
                                    <Text text="Bins (Trolleys)" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialCreatedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created By" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialCreatedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Date" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialCreatedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Time" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialChangedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed By" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialChangedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Date" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialChangedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Time" wrapping="false"/>
                                </Column>
                                <Column id="colMaterialAction" hAlign="Center" width="8rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                                    <Text text="Action" wrapping="false"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{refDocModel>materialCode}"/>
                                        <Text text="{refDocModel>refDocNo}"/>
                                        <Text text="{refDocModel>refDocItemNo}"/>
                                        <Text text="{refDocModel>materialDescription}"/>
                                        <Text text="{refDocModel>qty}"/>
                                        <Text text="{refDocModel>dispatchQty}"/>
                                        <Text text="{refDocModel>remainQty}"/>
                                        <Text text="{refDocModel>dispatchDate}"/>
                                        <Text text="{refDocModel>uom}"/>
                                        <Text text="{= ${refDocModel>binsTrolleys} || '0' }"/>
                                        <Text text="{refDocModel>createdBy}"/>
                                        <Text text="{refDocModel>createdOnDate}"/>
                                        <Text text="{refDocModel>createdOnTime}"/>
                                        <Text text="{refDocModel>changedBy}"/>
                                        <Text text="{refDocModel>changedOnDate}"/>
                                        <Text text="{refDocModel>changedOnTime}"/>
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceAround"
                                            width="100%"
                                            visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }">
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press=".onEditMaterialRow"/>
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press=".onDeleteMaterialRow"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                </ScrollContainer>
            </VBox>
        </Panel>

    </VBox>
</mvc:View>
