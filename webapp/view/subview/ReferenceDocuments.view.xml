<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.ReferenceDocuments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <VBox class="sapUiSizeCompact sapUiSmallMargin">

        <!-- ========================================================= -->
        <!-- =============== Reference Documents Panel =============== -->
        <!-- ========================================================= -->
        <Panel
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Reference Documents" class="sectionPanelTitle"/>
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiSizeCompact">
                <ScrollContainer
                    horizontal="true"
                    vertical="false"
                    width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                        <Table
                            id="idReferenceDocsTable"
                            inset="false"
                            mode="SingleSelectMaster"
                            width="auto"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{path: 'refDocModel>/referenceDocs'}"
                            selectionChange="onRefDocSelectionChange"
                            noDataText="No reference documents added yet">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Reference Documents" level="H6"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idRefDocColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onRefDocColumnSettings"/>
                                    <Button
                                        id="idAddRefDocButton"
                                        text="Add Document"
                                        icon="sap-icon://add"
                                        type="Emphasized"
                                        press="onAddRefDocRow"
                                        visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }"/>
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colRefDocType" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Doc Type"/>
                                </Column>
                                <Column id="colRefDocNumber" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Document Number"/>
                                </Column>
                                <Column id="colRefDocDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Document Date"/>
                                </Column>
                                <Column id="colEwayBillNumber" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline" visible="true">
                                    <Text text="EwayBill Number"/>
                                </Column>
                                <Column id="colEwayBillDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline" visible="true">
                                    <Text text="EwayBill Date"/>
                                </Column>
                                <Column id="colRefDocPartyCode" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Sending / Receiving Party Code"/>
                                </Column>
                                <Column id="colRefDocPartyName" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Sending / Receiving Party Name"/>
                                </Column>
                                <Column id="colRefDocCreatedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created By"/>
                                </Column>
                                <Column id="colRefDocCreatedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Date"/>
                                </Column>
                                <Column id="colRefDocCreatedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Time"/>
                                </Column>
                                <Column id="colRefDocChangedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed By"/>
                                </Column>
                                <Column id="colRefDocChangedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Date"/>
                                </Column>
                                <Column id="colRefDocChangedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Time"/>
                                </Column>
                                <Column id="colRefDocAction" hAlign="Center" width="12rem" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Action"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{refDocModel>docType}"/>
                                        <Text text="{refDocModel>documentNumber}"/>
                                        <Text text="{refDocModel>documentDate}"/>
                                        <Text text="{refDocModel>ewayBillNumber}"/>
                                        <Text text="{refDocModel>ewayBillDate}"/>
                                        <Text text="{refDocModel>partyCode}"/>
                                        <Text text="{refDocModel>partyName}"/>
                                        <Text text="{refDocModel>createdBy}"/>
                                        <Text text="{refDocModel>createdOnDate}"/>
                                        <Text text="{refDocModel>createdOnTime}"/>
                                        <Text text="{refDocModel>changedBy}"/>
                                        <Text text="{refDocModel>changedOnDate}"/>
                                        <Text text="{refDocModel>changedOnTime}"/>
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceAround"
                                            width="100%"
                                            visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }">
                                            <Button
                                                text="Select Materials"
                                                icon="sap-icon://list"
                                                type="Transparent"
                                                tooltip="Select Materials"
                                                press=".onSelectMaterialsFromTable"/>
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press=".onEditRefDocRow"/>
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press=".onDeleteRefDocRow"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                </ScrollContainer>
            </VBox>
        </Panel>



        <!-- ========================================================= -->
        <!-- =============== Material Details Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiSmallMarginTop">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Material Details" class="sectionPanelTitle"/>
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiSizeCompact">
                <ScrollContainer
                    horizontal="true"
                    vertical="false"
                    width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                        <Table
                            id="idMaterialDetailsTable"
                            inset="false"
                            width="auto"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            items="{path: 'refDocModel>/filteredMaterialDetails'}"
                            noDataText="No material rows added yet">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idMaterialColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onMaterialColumnSettings"/>
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="colMaterialCode" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Material Code"/>
                                </Column>
                                <Column id="colMaterialRefDocNo" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Ref Doc No"/>
                                </Column>
                                <Column id="colMaterialRefDocItemNo" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Ref Doc Item No"/>
                                </Column>
                                <Column id="colMaterialDescription" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Material Description"/>
                                </Column>
                                <Column id="colMaterialQuantity" hAlign="End" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Quantity"/>
                                </Column>
                                <Column id="colDispatchQty" hAlign="End" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Dispatch Qty"/>
                                </Column>
                                <Column id="colRemainQty" hAlign="End" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Remain Qty"/>
                                </Column>
                                <Column id="colDispatchDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Dispatch Date"/>
                                </Column>
                                <Column id="colMaterialUoM" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="UoM"/>
                                </Column>
                                <Column id="colMaterialBinsTrolleys" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline" hAlign="End">
                                    <Text text="Bins (Trolleys)"/>
                                </Column>
                                <Column id="colMaterialCreatedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created By"/>
                                </Column>
                                <Column id="colMaterialCreatedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Date"/>
                                </Column>
                                <Column id="colMaterialCreatedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Created On Time"/>
                                </Column>
                                <Column id="colMaterialChangedBy" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed By"/>
                                </Column>
                                <Column id="colMaterialChangedOnDate" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Date"/>
                                </Column>
                                <Column id="colMaterialChangedOnTime" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Changed On Time"/>
                                </Column>
                                <Column id="colMaterialAction" hAlign="Center" width="8rem" demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline">
                                    <Text text="Action"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{refDocModel>materialCode}"/>
                                        <Text text="{refDocModel>refDocNo}"/>
                                        <Text text="{refDocModel>refDocItemNo}"/>
                                        <Text text="{refDocModel>materialDescription}"/>
                                        <Text text="{refDocModel>qty}"/>
                                        <Text text="{refDocModel>dispatchQty}"/>
                                        <Text text="{refDocModel>remainQty}"/>
                                        <Text text="{refDocModel>dispatchDate}"/>
                                        <Text text="{refDocModel>uom}"/>
                                        <Text text="{= ${refDocModel>binsTrolleys} || '0' }"/>
                                        <Text text="{refDocModel>createdBy}"/>
                                        <Text text="{refDocModel>createdOnDate}"/>
                                        <Text text="{refDocModel>createdOnTime}"/>
                                        <Text text="{refDocModel>changedBy}"/>
                                        <Text text="{refDocModel>changedOnDate}"/>
                                        <Text text="{refDocModel>changedOnTime}"/>
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceAround"
                                            width="100%"
                                            visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }">
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit"
                                                press=".onEditMaterialRow"/>
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete"
                                                press=".onDeleteMaterialRow"/>
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                </ScrollContainer>
            </VBox>
        </Panel>

    </VBox>
</mvc:View>
