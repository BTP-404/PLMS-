<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.ReferenceDocuments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">

    <VBox class="sapUiSizeCompact sapUiSmallMargin">

        <!-- ========================================================= -->
        <!-- =============== Reference Documents Panel =============== -->
        <!-- ========================================================= -->
        <Panel
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Reference Documents"/>
                    <ToolbarSpacer/>
                    <Button
                        text="Document"
                        icon="sap-icon://add"
                        type="Transparent"
                        press="onAddRefDocRow"/>
                </OverflowToolbar>
            </headerToolbar>

            <!-- Main Content -->
            <VBox class="sapUiSizeCompact sapUiMediumPadding">

                <layout:Grid
                    defaultSpan="L12 M12 S12"
                    hSpacing="1"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop">

                    <!-- ================= TABLE COLUMN ================= -->
                    <layout:content>
                        <Table
                            id="idReferenceDocsTable"
                            inset="false"
                            mode="None"
                            width="100%"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{path: 'refDocModel>/referenceDocs'}"
                            noDataText="No reference documents added yet">

                            <columns>
                                <Column><Text text="Doc Type"/></Column>
                                <Column><Text text="Document Number"/></Column>
                                <Column><Text text="Document Date"/></Column>
                                <Column><Text text="Party Code"/></Column>
                                <Column><Text text="Party Name"/></Column>
                                <Column><Text text="Created By"/></Column>
                                <Column><Text text="Created On Date"/></Column>
                                <Column><Text text="Created On Time"/></Column>
                                <Column><Text text="Changed By"/></Column>
                                <Column><Text text="Changed On Date"/></Column>
                                <Column><Text text="Changed On Time"/></Column>
                                <Column hAlign="Center" width="6rem">
                                    <Text text="Action"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Input width="10rem" value="{refDocModel>docType}"/>
                                        <Input width="12rem" value="{refDocModel>documentNumber}"/>
                                        <DatePicker width="10rem" value="{refDocModel>documentDate}"/>
                                        <Input width="12rem" value="{refDocModel>partyCode}"/>
                                        <Input width="12rem" value="{refDocModel>partyName}"/>
                                        <Input width="10rem" value="{refDocModel>createdBy}"/>
                                        <DatePicker width="10rem" value="{refDocModel>createdOnDate}"/>
                                        <TimePicker width="10rem" value="{refDocModel>createdOnTime}"/>
                                        <Input width="10rem" value="{refDocModel>changedBy}"/>
                                        <DatePicker width="10rem" value="{refDocModel>changedOnDate}"/>
                                        <TimePicker width="10rem" value="{refDocModel>changedOnTime}"/>
                                        <Button
                                            icon="sap-icon://delete"
                                            type="Reject"
                                            press=".onDeleteRefDocRow"/>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                    </layout:content>

                </layout:Grid>

                <!-- Buttons aligned right -->
                <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
                    <Button text="Edit" type="Emphasized" press="onEditReferenceDocs"/>
                    <Button text="Save" type="Accept" class="sapUiTinyMarginBegin" press="onSaveReferenceDocs"/>
                </HBox>

            </VBox>
        </Panel>



        <!-- ========================================================= -->
        <!-- =============== Material Details Panel ================== -->
        <!-- ========================================================= -->
        <Panel
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiSmallMarginTop">

            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Material Details"/>
                    <ToolbarSpacer/>
                    <Button
                        text="Material"
                        icon="sap-icon://add"
                        type="Transparent"
                        press="onAddMaterialRow"/>
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding">

                <layout:Grid
                    defaultSpan="L12 M12 S12"
                    hSpacing="1"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop">

                    <layout:content>
                        <Table
                            id="idMaterialDetailsTable"
                            inset="false"
                            width="100%"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders"
                            growing="true"
                            growingScrollToLoad="true"
                            items="{path: 'refDocModel>/materialDetails'}"
                            noDataText="No material rows added yet">

                            <columns>
                                <Column><Text text="Ref Doc No"/></Column>
                                <Column><Text text="Ref Doc Item No"/></Column>
                                <Column><Text text="Material Code"/></Column>
                                <Column><Text text="Material Description"/></Column>
                                <Column hAlign="End"><Text text="Quantity"/></Column>
                                <Column><Text text="UoM"/></Column>
                                <Column><Text text="Created By"/></Column>
                                <Column><Text text="Created On Date"/></Column>
                                <Column><Text text="Created On Time"/></Column>
                                <Column><Text text="Changed By"/></Column>
                                <Column><Text text="Changed On Date"/></Column>
                                <Column><Text text="Changed On Time"/></Column>
                                <Column hAlign="Center" width="6rem">
                                    <Text text="Action"/>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{refDocModel>refDocNo}"/>
                                        <Text text="{refDocModel>refDocItemNo}"/>
                                        <Text text="{refDocModel>materialCode}"/>
                                        <Text text="{refDocModel>materialDescription}"/>
                                        <Text text="{refDocModel>qty}"/>
                                        <Text text="{refDocModel>uom}"/>
                                        <Text text="{refDocModel>createdBy}"/>
                                        <Text text="{refDocModel>createdOnDate}"/>
                                        <Text text="{refDocModel>createdOnTime}"/>
                                        <Text text="{refDocModel>changedBy}"/>
                                        <Text text="{refDocModel>changedOnDate}"/>
                                        <Text text="{refDocModel>changedOnTime}"/>
                                        <Button
                                            icon="sap-icon://delete"
                                            type="Reject"
                                            press=".onDeleteMaterialRow"/>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                    </layout:content>

                </layout:Grid>

                <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
                    <Button text="Edit" type="Emphasized" press="onEditMaterialDetails"/>
                    <Button text="Save" type="Accept" class="sapUiTinyMarginBegin" press="onSaveMaterialDetails"/>
                </HBox>

            </VBox>
        </Panel>

    </VBox>
</mvc:View>
