<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.AttachmentsTab"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
>

    <VBox class="sapUiSizeCompact sapUiTinyMargin">

        <!-- ========================================================= -->
        <!-- Upload Section -->
        <!-- ========================================================= -->
        <Panel
            id="uploadDocumentPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Upload Document" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                >
                    <!-- Stage Selection -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Select Stage"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Select
                                id="idStageSelect"
                                width="100%"
                                selectedItem=""
                            >
                                <core:Item key="" text="Select Stage..." />
                                <core:Item key="Reporting" text="Reporting" />
                                <core:Item key="GateIn" text="Gate In" />
                                <core:Item key="Loading" text="Loading" />
                                <core:Item key="Unloading" text="Unloading" />
                                <core:Item key="GateOut" text="Gate Out" />
                            </Select>
                        </VBox>
                    </layout:content>

                    <!-- File Uploader -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Upload File"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <HBox alignItems="Center" width="100%">
                                <unified:FileUploader
                                    id="idUnifiedUploader"
                                    name="uploadFile"
                                    placeholder="Choose file (PDF or image)"
                                    fileType="pdf,jpg,jpeg,png"
                                    icon="sap-icon://upload"
                                    width="100%"
                                    change=".onFileChange"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="idPreviewSelectedFile"
                                    icon="sap-icon://show"
                                    tooltip="Preview Selected File"
                                    type="Transparent"
                                    enabled="false"
                                    press=".onPreviewSelectedFile"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Upload Button -->
                <HBox justifyContent="End" class="sapUiTinyMarginTop">
                    <Button
                        text="Upload"
                        type="Accept"
                        icon="sap-icon://upload-to-cloud"
                        press=".onUploadDocument"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- Uploaded Files List -->
        <!-- ========================================================= -->
        <Panel
            id="uploadedFilesPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiTinyMarginTop"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Uploaded Files" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <List
                    id="idUploadedFilesList"
                    mode="Delete"
                    noDataText="No files uploaded yet."
                    delete=".onDeleteFile"
                    items="{attachmentsModel>/attachments}"
                    class="sapUiSizeCompact"
                >
                    <items>
                        <CustomListItem>
                            <HBox alignItems="Center" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                <core:Icon
                                    src="sap-icon://attachment"
                                    size="1.5rem"
                                    class="sapUiTinyMarginEnd"
                                    color="#0070f2"
                                />
                                <VBox class="sapUiTinyMarginBegin" flex="1">
                                    <Text
                                        text="{attachmentsModel>fileName}"
                                        class="sapUiTinyMarginBottom"
                                        wrapping="true"
                                    />
                                    <Text
                                        text="{attachmentsModel>contentType}"
                                        class="sapUiSmallFontSize"
                                        wrapping="true"
                                    />
                                </VBox>
                                <Button
                                    text="Preview / Open"
                                    type="Emphasized"
                                    icon="sap-icon://show"
                                    press=".onPreviewAttachment"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </CustomListItem>
                    </items>
                </List>
            </VBox>
        </Panel>

    </VBox>

</mvc:View>
