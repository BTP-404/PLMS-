<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.Stage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified">

    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- Upload Panel -->
        <Panel
            headerText="Upload Document"
            class="sapUiNoContentPadding"
            expandable="true"
            expanded="true">

            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin">

                <!-- Dropdown for Stage -->
                <VBox width="40%">
                    <Text text="Select Stage:" class="sapUiTinyMarginBottom"/>
                    <Select id="idStageSelect" width="100%" selectedItem="">
                    		 <core:Item key="" text="Select Stage..."/>
                    	 <core:Item key="Reporting" text="Reporting"/>
                        <core:Item key="GateIn" text="Gate In"/>
                        <core:Item key="Loading" text="Loading"/>
                        <core:Item key="Unloading" text="Unloading"/>
                        <core:Item key="GateOut" text="Gate Out"/>
                    </Select>
                </VBox>

                <!-- Unified File Uploader -->
                <VBox width="45%">
                    <Text text="Upload File:" class="sapUiTinyMarginBottom"/>
                    <unified:FileUploader
                        id="idUnifiedUploader"
                        name="uploadFile"
                        placeholder="Choose file (PDF or image)"
                        fileType="pdf,jpg,jpeg,png"
                        icon="sap-icon://upload"
                        width="100%"
                        change=".onFileChange"/>
                </VBox>

            </HBox>

            <HBox justifyContent="End" class="sapUiTinyMarginTop">
                <Button text="Upload"
                        type="Accept"
                        icon="sap-icon://upload-to-cloud"
                        press=".onUploadDocument"/>
            </HBox>
        </Panel>

        <!-- Uploaded Files List -->
        <Panel headerText="Uploaded Files" class="sapUiNoContentPadding sapUiSmallMarginTop" expandable="true">
            <List id="idUploadedFilesList"
                  noDataText="No files uploaded yet."
                  mode="Delete"
                  delete=".onDeleteFile"/>
        </Panel>

    </VBox>
</mvc:View>
