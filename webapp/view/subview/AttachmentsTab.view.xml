<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.AttachmentsTab"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
>

    <VBox class="sapUiSizeCompact sapUiTinyMargin">

        <!-- ========================================================= -->
        <!-- Upload Section -->
        <!-- ========================================================= -->
        <Panel
            id="uploadDocumentPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Upload Document" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                >
                    <!-- Stage Selection -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Select Stage"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Select
                                id="idStageSelect"
                                width="100%"
                                selectedItem=""
                            >
                                <core:Item key="" text="Select Stage..." />
                                <core:Item key="Reporting" text="Reporting" />
                                <core:Item key="GateIn" text="Gate In" />
                                <core:Item key="Loading" text="Loading" />
                                <core:Item key="Unloading" text="Unloading" />
                                <core:Item key="GateOut" text="Gate Out" />
                            </Select>
                        </VBox>
                    </layout:content>

                    <!-- File Uploader -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Upload File"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <unified:FileUploader
                                id="idUnifiedUploader"
                                name="uploadFile"
                                placeholder="Choose file (PDF or image)"
                                fileType="pdf,jpg,jpeg,png"
                                icon="sap-icon://upload"
                                width="100%"
                                change=".onFileChange"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Upload Button -->
                <HBox justifyContent="End" class="sapUiTinyMarginTop">
                    <Button
                        text="Upload"
                        type="Accept"
                        icon="sap-icon://upload-to-cloud"
                        press=".onUploadDocument"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- Uploaded Files List -->
        <!-- ========================================================= -->
        <Panel
            id="uploadedFilesPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiTinyMarginTop"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Uploaded Files" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <List
                    id="idUploadedFilesList"
                    mode="Delete"
                    noDataText="No files uploaded yet."
                    delete=".onDeleteFile"
                    items="{attachmentsModel>/attachments}"
                    class="sapUiSizeCompact"
                >
                    <items>
                        <StandardListItem
                            title="{attachmentsModel>fileName}"
                            description="{attachmentsModel>contentType}"
                            type="Active"
                            press=".onPreviewAttachment"
                            icon="sap-icon://attachment"
                        />
                    </items>
                </List>
            </VBox>
        </Panel>

    </VBox>

</mvc:View>
