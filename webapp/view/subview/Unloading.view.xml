<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Unloading"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ===================== MATERIAL DETAILS PANEL ===================== -->
        <Panel
            id="materialDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Unloading" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSmallMargin sapUiSizeCompact">

                <!-- ===================== TABLE SECTION ===================== -->
                <ScrollContainer horizontal="true" vertical="false" width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                    <HBox wrap="Wrap" width="auto">
                        <Table
                            id="idUnloadingMaterialTable"
                            inset="false"
                            mode="None"
                            width="100%"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{tableModel>/materials}"
                        >
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6" />
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idUnloadingColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onUnloadingColumnSettings"/>
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column
                                    id="colUnloadingRefDocNumber"
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Ref Doc Number" />
                                </Column>
                                <Column
                                    id="colUnloadingRefDocItemNumber"
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Ref Doc Item Number" />
                                </Column>
                                <Column
                                    id="colUnloadingMaterialCode"
                                    demandPopin="true"
                                    minScreenWidth="Tablet"
                                >
                                    <Text text="Material Code" />
                                </Column>
                                <Column
                                    id="colUnloadingMaterialDescription"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Material Description" />
                                </Column>
                                <Column
                                    id="colUnloadingQty"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                >
                                    <Text text="Qty" />
                                </Column>
                                <Column
                                    id="colUnloadingUoM"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                >
                                    <Text text="UoM" />
                                </Column>
                                <Column
                                    id="colUnloadingUnloadedQty"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Unloaded Qty / Net Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingGrossWt"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Gross Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingTareWt"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Tare Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingNetWt"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Net Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingCreatedBy"
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                >
                                    <Text text="Created By" />
                                </Column>
                                <Column
                                    id="colUnloadingCreatedOnDate"
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Created On Date" />
                                </Column>
                                <Column
                                    id="colUnloadingCreatedOnTime"
                                    demandPopin="true"
                                    minScreenWidth="XLarge"
                                    popinDisplay="Inline"
                                >
                                    <Text text="Created On Time" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{tableModel>RefDocNumber}"/>
                                        <Text text="{tableModel>RefDocItemNumber}"/>
                                        <Text text="{tableModel>MaterialCode}"/>
                                        <Text text="{tableModel>MaterialDescription}"/>
                                        <Text text="{tableModel>Qty}"/>
                                        <Text text="{tableModel>UoM}"/>
                                        <Input
                                            value="{tableModel>UnloadedQty}"
                                            enabled="{unloadingModel>/weighmentEnabled}"
                                            placeholder="Enter Unloaded Qty"
                                            width="100%"
                                            type="Number"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>GrossWt}"
                                            enabled="{unloadingModel>/weighmentEnabled}"
                                            placeholder="Enter Gross Wt"
                                            width="100%"
                                            type="Number"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>TareWt}"
                                            enabled="{unloadingModel>/weighmentEnabled}"
                                            placeholder="Enter Tare Wt"
                                            width="100%"
                                            type="Number"
                                            change="onWeightFieldChange"
                                        />
                                        <Text text="{tableModel>NetWt}"/>
                                        <Text text="{tableModel>CreatedBy}"/>
                                        <Text text="{tableModel>CreatedOnDate}"/>
                                        <Text text="{tableModel>CreatedOnTime}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </HBox>
                </ScrollContainer>

            </VBox>
        </Panel>

        <!-- ===================== BUTTONS AT BOTTOM ===================== -->
        <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
            <!-- Start Unloading Button -->
                    <Button 
                        id="btnStartUnloading" 
                        text="Start Unloading" 
                        type="Accept" 
                        press="onStartUnloading" 
                        icon="sap-icon://unload"
                        enabled="true" 
                    />

                    <!-- End Unloading Button -->
                    <Button 
                        id="btnEndUnloading" 
                        text="End Unloading" 
                        type="Reject" 
                        press="onEndUnloading" 
                        icon="sap-icon://cart-5"
                        enabled="false" 
                        class="sapUiTinyMarginBegin"
                    />
        </HBox>

    </VBox>
</mvc:View>

