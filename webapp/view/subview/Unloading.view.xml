<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.Unloading"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">

        <!-- ===================== MATERIAL DETAILS PANEL ===================== -->
        <Panel
            id="materialDetailsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
            stickyHeader="true"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Unloading" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding">

                <!-- ===================== TABLE SECTION ===================== -->
                <ScrollContainer
                    horizontal="true"
                    vertical="false"
                    width="100%"
                    class="sapUiNoContentPadding sapUiSmallMarginTop sapUiSizeCompact">
                        <Table
                            id="idUnloadingMaterialTable"
                            inset="false"
                            width="auto"
                            class="sapUiSizeCompact"
                            fixedLayout="false"
                            autoPopin="true"
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            growingScrollToLoad="true"
                            growingThreshold="20"
                            items="{tableModel>/materials}"
                            noDataText="No materials unloaded yet">
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Material Details" level="H6" />
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idUnloadingColumnsButton"
                                        icon="sap-icon://action-settings"
                                        tooltip="Column Settings"
                                        press="onUnloadingColumnSettings"/>
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column
                                    id="colUnloadingRefDocNumber"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Ref Doc Number" />
                                </Column>
                                <Column
                                    id="colUnloadingRefDocItemNumber"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Ref Doc Item Number" />
                                </Column>
                                <Column
                                    id="colUnloadingMaterialCode"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Material Code" />
                                </Column>
                                <Column
                                    id="colUnloadingMaterialDescription"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Material Description" />
                                </Column>
                                <Column
                                    id="colUnloadingQty"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Qty" />
                                </Column>
                                <Column
                                    id="colUnloadingUoM"
                                    hAlign="Center"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="UoM" />
                                </Column>
                                <Column
                                    id="colUnloadingQtyConfirm"
                                    hAlign="Center"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Qty Confirmed" />
                                </Column>
                                <Column
                                    id="colUnloadingUnloadedWeight"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Unloaded Quantity" />
                                </Column>
                                <Column
                                    id="colUnloadingGrossWt"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{unloadingModel>/weighmentEnabled}">
                                    <Text text="Gross Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingTareWt"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{unloadingModel>/weighmentEnabled}">
                                    <Text text="Tare Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingNetWt"
                                    hAlign="End"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline"
                                    visible="{unloadingModel>/weighmentEnabled}">
                                    <Text text="Net Wt" />
                                </Column>
                                <Column
                                    id="colUnloadingRemark"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Remark" />
                                </Column>
                                <Column
                                    id="colUnloadingCreatedBy"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Created By" />
                                </Column>
                                <Column
                                    id="colUnloadingCreatedOnDate"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Created On Date" />
                                </Column>
                                <Column
                                    id="colUnloadingCreatedOnTime"
                                    demandPopin="true"
                                    minScreenWidth="Desktop"
                                    popinDisplay="Inline">
                                    <Text text="Created On Time" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{tableModel>RefDocNumber}"/>
                                        <Text text="{tableModel>RefDocItemNumber}"/>
                                        <Text text="{tableModel>MaterialCode}"/>
                                        <Text text="{tableModel>MaterialDescription}"/>
                                        <Text 
                                            text="{tableModel>Qty}"
                                            textAlign="End"/>
                                        <Text 
                                            text="{tableModel>UoM}"
                                            textAlign="Center"/>
                                        <HBox justifyContent="Center" alignItems="Center">
                                            <CheckBox
                                                selected="{= ${tableModel>ConfirmQty} === 'X' }"
                                                select=".onConfirmQtySelect"
                                                tooltip="Confirm Quantity (backend field ConfirmQty)"
                                            />
                                        </HBox>
                                        <Input
                                            value="{tableModel>UnloadedWeight}"
                                            enabled="true"
                                            placeholder="Enter Weight"
                                            width="8rem"
                                            type="Number"
                                            textAlign="End"
                                            class="sapUiSizeCompact"
                                            liveChange="onWeightFieldChange"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>GrossWt}"
                                            enabled="{unloadingModel>/weighmentEnabled}"
                                            placeholder="Gross Wt"
                                            width="7rem"
                                            type="Number"
                                            textAlign="End"
                                            class="sapUiSizeCompact"
                                            change="onWeightFieldChange"
                                        />
                                        <Input
                                            value="{tableModel>TareWt}"
                                            enabled="{unloadingModel>/weighmentEnabled}"
                                            placeholder="Tare Wt"
                                            width="7rem"
                                            type="Number"
                                            textAlign="End"
                                            class="sapUiSizeCompact"
                                            change="onWeightFieldChange"
                                        />
                                        <Text 
                                            text="{tableModel>NetWt}"
                                            textAlign="End"
                                            class="sapUiTinyMarginEnd"/>
                                        <Input
                                            value="{tableModel>Remark}"
                                            placeholder="Remark"
                                            width="10rem"
                                            maxLength="255"
                                            class="sapUiSizeCompact"
                                        />
                                        <Text text="{tableModel>CreatedBy}"/>
                                        <Text text="{tableModel>CreatedOnDate}"/>
                                        <Text text="{tableModel>CreatedOnTime}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                </ScrollContainer>

            </VBox>
        </Panel>

        <!-- ===================== BUTTONS AT BOTTOM ===================== -->
        <HBox justifyContent="End" class="sapUiSmallMarginTop sapUiSmallMarginEnd">
            <!-- Save Unloading (weights/quantities/remark) -->
            <Button 
                id="btnSaveUnloading" 
                text="Save" 
                type="Emphasized" 
                press="onSaveUnloading" 
                icon="sap-icon://save"
            />

            <!-- Start Unloading Button -->
            <Button 
                id="btnStartUnloading" 
                text="Start Unloading" 
                type="Accept" 
                press="onStartUnloading" 
                icon="sap-icon://unload"
                class="sapUiTinyMarginBegin"
            />

            <!-- ReStart Unloading Button (shown when unloading is ended) -->
            <Button 
                id="btnReStartUnloading" 
                text="ReStart Unloading" 
                type="Accept" 
                press="onReStartUnloading" 
                icon="sap-icon://refresh"
                visible="false"
                class="sapUiTinyMarginBegin"
            />

            <!-- End Unloading Button -->
            <Button 
                id="btnEndUnloading" 
                text="End Unloading" 
                type="Reject" 
                press="onEndUnloading" 
                icon="sap-icon://cart-5"
                class="sapUiTinyMarginBegin"
            />
        </HBox>

    </VBox>
</mvc:View>

