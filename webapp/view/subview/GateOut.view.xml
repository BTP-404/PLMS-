<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateOut"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact" width="100%">
        <!-- Search by + document value help (hidden for O02 + vehicle type 02, or outbound O + type 02 + External; use Reference Documents "Add Document") -->
        <layout:Grid
            defaultSpan="L12 M12 S12"
            hSpacing="2"
            vSpacing="2"
            width="100%"
            class="sapUiTinyMarginBottom sapUiMediumPadding gateOutSearchCard"
            visible="{gateOutUi>/showGateOutRefSearchStrip}"
        >
            <layout:content>
                <VBox width="100%">
                    <layoutData>
                        <layout:GridData span="L6 M6 S12" />
                    </layoutData>
                    <Label
                        text="Search by"
                        labelFor="idGateOutReferenceBySelect"
                        design="Bold"
                        class="sapUiNoMarginBottom"
                    />
                    <Select
                        id="idGateOutReferenceBySelect"
                        width="100%"
                        class="gateOutSearchSelect"
                        selectedKey="{gateOutUi>/referenceByKey}"
                        change="onGateOutReferenceByChange"
                    >
                        <core:ListItem key="INVOICE" text="Invoice" />
                        <core:ListItem key="CHALLAN" text="Challan" />
                        <core:ListItem key="PO" text="PO" />
                    </Select>
                </VBox>
            </layout:content>
            <layout:content>
                <VBox width="100%">
                    <layoutData>
                        <layout:GridData span="L6 M6 S12" />
                    </layoutData>
                    <Label
                        text="Document Number"
                        labelFor="idGateOutRefDocSearchInput"
                        design="Bold"
                        class="sapUiNoMarginBottom"
                    />
                    <Input
                        id="idGateOutRefDocSearchInput"
                        width="100%"
                        class="gateOutSearchInput"
                        value="{gateOutUi>/refDocSearchValue}"
                        showSuggestion="true"
                        startSuggestion="1"
                        filterSuggests="true"
                        maxSuggestionWidth="32rem"
                        placeholder="{= ${gateOutUi>/referenceByKey} === 'INVOICE' ? 'Type or select invoice' : (${gateOutUi>/referenceByKey} === 'CHALLAN' ? 'Type or select challan' : 'Type or select PO number') }"
                        suggestionItems="{gateOutRefSuggest>/items}"
                        suggest="onGateOutRefDocSuggest"
                        suggestionItemSelected="onGateOutRefDocSuggestionSelected"
                        change="onGateOutRefDocSearchChange"
                    >
                        <suggestionItems>
                            <SuggestionItem
                                text="{gateOutRefSuggest>docText}"
                                description="{gateOutRefSuggest>docDescription}"
                            />
                        </suggestionItems>
                    </Input>
                </VBox>
            </layout:content>
        </layout:Grid>
        <!-- ========================================================= -->
        <!-- =================== Reporting (internal) ================= -->
        <!-- ========================================================= -->
        <mvc:XMLView
            id="idVehicleReportingEmbeddedGateOut"
            viewName="com.incresolZ_INC_PLMS.view.subview.VehicleReportingTab"
            class="sapUiTinyMarginBottom"
            visible="{= ${stageUi>/showReportingInGateOut} === true &amp;&amp; String(${TripData>/MovementType} || '').toUpperCase() !== 'I' }"
        />

        <!-- ========================================================= -->
        <!-- =============== Reference Documents (merged) ============= -->
        <!-- ========================================================= -->
        <mvc:XMLView
            id="idRefDocsViewGateOut"
            viewName="com.incresolZ_INC_PLMS.view.subview.ReferenceDocuments"
            class="sapUiTinyMarginBottom"
            visible="{gateOutUi>/showPanels}"
        />

        <!-- ========================================================= -->
        <!-- =========== Gate Out Bin / Trolley Tracking (before Gate-Out) ========= -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutBinTrolleyPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
            visible="{= ${gateOutUi>/showPanels} === true &amp;&amp; ${ui>/showBinTrolleyTracking} === true }"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Bin / Trolley Tracking" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>
            <VBox class="sapUiSizeCompact" width="100%">
                <Table
                    id="idGateOutBinTrolleyTable"
                    width="100%"
                    fixedLayout="true"
                    autoPopin="true"
                    popinLayout="GridSmall"
                    items="{binTrolleyTracking>/items}"
                    class="sapUiSizeCompact binTrolleyTrackingTable plmsPanelDataTable"
                >
                    <columns>
                        <Column width="8rem" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                            <Text text="Doc No" />
                        </Column>
                        <Column width="6rem" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                            <Text text="Item" />
                        </Column>
                        <Column width="9rem" demandPopin="true" minScreenWidth="Phone" popinDisplay="Inline">
                            <Text text="Part Code" />
                        </Column>
                        <Column width="12rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                            <Text text="Bin Type" />
                        </Column>
                        <Column hAlign="End" width="8rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
                            <Text text="Qty Out" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem class="binTrolleyTrackingRow">
                            <cells>
                                <Text text="{binTrolleyTracking>DocumentNumber}" />
                                <Text text="{binTrolleyTracking>ItemNo}" />
                                <Text text="{binTrolleyTracking>Material}" class="binTrolleyPartCode" />
                                <Text text="{= ${binTrolleyTracking>BinTypeDesc} || ${binTrolleyTracking>BinType} }" />
                                <ObjectNumber number="{binTrolleyTracking>QtyOut}" emphasized="false" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <HBox justifyContent="End" class="sapUiTinyMarginTop binTrolleyTrackingTotalBar">
                    <Text
                        text="{path: 'binTrolleyTracking>/totalQtyOut', formatter: '.formatTrackingTotalQtyOutLine'}"
                        class="sapUiTinyMarginEnd binTrolleyTrackingTotalLabel"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ==================== Gate Out Details ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
            visible="{gateOutUi>/showPanels}"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-Out" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding plmsGateOutForm">
                <!-- Row 1: Exit Gate | Related Trip (Gate Pass No) | Verified Documents -->
                <layout:Grid
                    defaultSpan="L4 M4 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Exit Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <ComboBox
                                id="idExitGateNumber"
                                width="100%"
                                editable="{= !${globalData>/TripLocked} }"
                                placeholder="Select exit gate"
                                selectedKey="{path: 'TripData>/ExitGateNum', mode: 'OneWay'}"
                                items="{exitGateModel>/items}"
                                change="onExitGateSelectionChange"
                            >
                                <core:Item
                                    key="{exitGateModel>ConfigID}"
                                    text="{exitGateModel>ConfigID}"
                                    templateShareable="false"
                                />
                            </ComboBox>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Related Trip Number (Gate Pass No)"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idGateOutRelatedTripNumber"
                                width="100%"
                                value="{
                                    path: 'TripData>/TripNumber',
                                    formatter: '.formatTripNumber'
                                }"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Verified the Documents?"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idVerifiedDocs"
                                columns="2"
                                selectedIndex="{path: 'TripData>/VerifiedDocs', formatter: '.formatVerifiedDocsIndex'}"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Row 2: Skip Document -->
                <layout:Grid
                    defaultSpan="L12 M12 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Skip Document"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idSkipDocumentGateOut"
                                columns="2"
                                selectedIndex="{path: 'TripData>/RefDocSkip', formatter: '.formatRefDocSkipIndex'}"
                                select="onRefDocSkipChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Row 3: Remarks | Additional Info -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutRemarks"
                                rows="4"
                                growing="true"
                                growingMaxLines="8"
                                placeholder="Enter any remarks"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Additional Info"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutAdditionalInfo"
                                rows="4"
                                growing="true"
                                growingMaxLines="12"
                                placeholder="Enter additional information"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateOut"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateOut"
                        visible="{= !${globalData>/TripLocked} }"
                    />
                    <Button
                        id="btnSaveGateOut"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateOut"
                        class="sapUiTinyMarginBegin"
                        visible="{= !${globalData>/TripLocked} }"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
