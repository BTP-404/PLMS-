<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateOut"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSmallMargin sapUiSizeCompact">
        <!-- ========================================================= -->
        <!-- ==================== Gate Out Details ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <!-- Header Toolbar (NO BUTTONS here anymore) -->
            <headerToolbar>
                <OverflowToolbar style="Clear">
                    <Title text="Gate Out Details" />
                </OverflowToolbar>
            </headerToolbar>

            <!-- Body -->
            <VBox class="sapUiSizeCompact sapUiMediumPadding">
                <!-- ========================================================= -->
                <!-- ========================== ROW 1 ========================= -->
                <!-- Exit Gate No + Document Verified + Upload Attachment -->
                <!-- ========================================================= -->

                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                >
                    <!-- Exit Gate Number -->
                    <layout:content>
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                            binding="{TripData>/}"
                        >
                            <Label
                                text="Exit Gate Number"
                                required="true"
                                design="Bold"
                            />
                            <Input
                                id="idExitGateNumber"
                                showValueHelp="true"
                                placeholder="Select Exit Gate"
                                valueHelpRequest="onExitGateValueHelp"
                            />
                        </form:SimpleForm>
                    </layout:content>

                    <!-- Verified Docs -->
                    <layout:content>
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                            binding="{TripData>/}"
                        >
                            <Label
                                text="Verified the Documents?"
                                required="true"
                                design="Bold"
                            />
                            <RadioButtonGroup
                                id="idVerifiedDocs"
                                columns="2"
                                selectedIndex="{TripData>/VerifiedDocs}"
                            >
                                <buttons>
                                    <RadioButton
                                        text="Yes"
                                        key="Y"
                                    />
                                    <RadioButton
                                        text="No"
                                        key="N"
                                    />
                                </buttons>
                            </RadioButtonGroup>
                        </form:SimpleForm>
                    </layout:content>

                    <!-- Upload Attachments -->
                    <layout:content>
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                            binding="{TripData>/}"
                        >
                            <Label
                                text="Upload Attachments"
                                design="Bold"
                            />
                            <unified:FileUploader
                                id="idGateOutAttachments"
                                multiple="true"
                                buttonText="Upload"
                                fileType="jpg,png,pdf,docx"
                                placeholder="Attach related documents"
                                uploadUrl="/upload"
                                change="onGateOutAttachmentChange"
                            />
                        </form:SimpleForm>
                    </layout:content>
                </layout:Grid>

                <!-- ========================================================= -->
                <!-- ========================== ROW 2 ========================= -->
                <!-- Remarks + Additional Info -->
                <!-- ========================================================= -->

                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- Remarks -->
                    <layout:content>
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                            binding="{TripData>/}"
                        >
                            <Label
                                text="Remarks"
                                design="Bold"
                            />
                            <TextArea
                                id="idGateOutRemarks"
                                value="{TripData>/GateOutRemarks}"
                                width="100%"
                            />
                        </form:SimpleForm>
                    </layout:content>

                    <!-- Additional Info -->
                    <layout:content>
                        <form:SimpleForm
                            layout="ResponsiveGridLayout"
                            labelSpanL="4"
                            labelSpanM="4"
                            columnsL="1"
                            columnsM="1"
                            class="sapUiNoContentPadding"
                            binding="{TripData>/}"
                        >
                            <Label
                                text="Additional Info"
                                design="Bold"
                            />
                            <TextArea
                                id="idGateOutAdditionalInfo"
                                value="{TripData>/GateOutAdditionalInfo}"
                                growing="true"
                                width="100%"
                            />
                        </form:SimpleForm>
                    </layout:content>
                </layout:Grid>

                <!-- ========================================================= -->
                <!-- ==================== BUTTON ROW ======================== -->
                <!-- Right-aligned inside panel, last row -->
                <!-- ========================================================= -->

                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginTop sapUiSmallMarginEnd"
                    width="100%"
                >
                    <Button
                        id="btnEditGateOut"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateOut"
                    />
                    <Button
                        id="btnSaveGateOut"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateOut"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ==================== Change History ===================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutHistoryPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar style="Clear">
                    <Title text="Change History" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox
                class="sapUiSmallMargin sapUiMediumPadding sapUiSizeCompact"
                binding="{TripData>/}"
            >
                <Title
                    text="Change History"
                    level="H5"
                    class="sapUiSmallMarginBottom sapUiTinyMarginTop"
                />

                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    width="100%"
                    hSpacing="2"
                    vSpacing="2"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created By"
                                design="Bold"
                            />
                            <Input
                                id="idGateOutCreatedBy"
                                value="{TripData>/GateOutCreatedBy}"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>

                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Created On Date"
                                design="Bold"
                            />
                            <DatePicker
                                id="idGateOutCreatedOnDate"
                                value="{TripData>/GateOutCreatedOnDate}"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <VBox width="100%">
                    <Label
                        text="Created On Time"
                        design="Bold"
                    />
                    <TimePicker
                        id="idGateOutCreatedOnTime"
                        value="{TripData>/GateOutCreatedOnTime}"
                        enabled="false"
                    />
                </VBox>
            </VBox>
        </Panel>
    </VBox>
</mvc:View>
