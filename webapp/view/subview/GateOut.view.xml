<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateOut"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact" width="100%">
        <!-- ========================================================= -->
        <!-- =================== Reporting (internal) ================= -->
        <!-- ========================================================= -->
        <mvc:XMLView
            viewName="com.incresolZ_INC_PLMS.view.subview.VehicleReportingTab"
            class="sapUiTinyMarginBottom"
            visible="{= ${stageUi>/showReportingInGateOut} === true }"
        />

        <!-- ========================================================= -->
        <!-- =============== Reference Documents (merged) ============= -->
        <!-- ========================================================= -->
        <mvc:XMLView
            id="idRefDocsViewGateOut"
            viewName="com.incresolZ_INC_PLMS.view.subview.ReferenceDocuments"
            class="sapUiTinyMarginBottom"
        />

        <!-- ========================================================= -->
        <!-- =========== Gate Out Bin / Trolley Tracking (before Gate-Out) ========= -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutBinTrolleyPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
            visible="{ui>/showBinTrolleyTracking}"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Bin / Trolley Tracking" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallMargin" width="100%">
                <Table
                    id="idGateOutBinTrolleyTable"
                    width="100%"
                    fixedLayout="false"
                    class="sapUiSizeCompact gateOutBinTrolleyTable plmsPanelDataTable"
                    items="{gateOutBinTrolley>/rows}"
                >
                    <columns>
                        <Column width="7rem"><Text text="Doc No" /></Column>
                        <Column width="6rem"><Text text="Item" /></Column>
                        <Column width="8rem"><Text text="Part Code" /></Column>
                        <Column width="14rem"><Text text="Bin Type / Material Desc." /></Column>
                        <Column hAlign="End" width="7rem"><Text text="Qty Out" /></Column>
                        <Column hAlign="Center" width="11rem"><Text text="Status" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{gateOutBinTrolley>DocumentNumber}" />
                                <Text text="{gateOutBinTrolley>ItemNo}" />
                                <Text text="{gateOutBinTrolley>Material}" class="binTrolleyPartCode" />
                                <ObjectStatus
                                    text="{path: 'gateOutBinTrolley>', formatter: '.formatGateOutBinTypeText'}"
                                    state="{path: 'gateOutBinTrolley>BinTypeState', formatter: '.formatTrackingStatusState'}"
                                    inverted="true"
                                />
                                <ObjectNumber
                                    number="{gateOutBinTrolley>QtyOut}"
                                    emphasized="false"
                                />
                                <ObjectStatus
                                    text="{gateOutBinTrolley>Status}"
                                    state="{path: 'gateOutBinTrolley>Status', formatter: '.formatGateOutDispatchState'}"
                                    icon="sap-icon://circle-task-2"
                                    inverted="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ==================== Gate Out Details ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-Out" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding plmsGateOutForm">
                <!-- Row 1: Exit Gate | Related Trip (Gate Pass No) | Verified Documents -->
                <layout:Grid
                    defaultSpan="L4 M4 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Exit Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <ComboBox
                                id="idExitGateNumber"
                                width="100%"
                                editable="true"
                                placeholder="Select exit gate"
                                selectedKey="{path: 'TripData>/ExitGateNum', mode: 'OneWay'}"
                                items="{exitGateModel>/items}"
                            >
                                <core:Item
                                    key="{exitGateModel>ConfigID}"
                                    text="{exitGateModel>ConfigID}"
                                    templateShareable="false"
                                />
                            </ComboBox>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Related Trip Number (Gate Pass No)"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idGateOutRelatedTripNumber"
                                width="100%"
                                value="{
                                    path: 'TripData>/TripNumber',
                                    formatter: '.formatTripNumber'
                                }"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Verified the Documents?"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idVerifiedDocs"
                                columns="2"
                                selectedIndex="{path: 'TripData>/VerifiedDocs', formatter: '.formatVerifiedDocsIndex'}"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Row 2: Skip Document | Bins Returned | Short Quantity -->
                <layout:Grid
                    defaultSpan="L4 M4 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Skip Document"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idSkipDocumentGateOut"
                                columns="2"
                                selectedIndex="{path: 'TripData>/RefDocSkip', formatter: '.formatRefDocSkipIndex'}"
                                select="onRefDocSkipChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Bins Returned"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idBinsReturned"
                                width="100%"
                                type="Number"
                                placeholder="Enter bins returned"
                                value="{path: 'TripData>/BinsReturned', mode: 'TwoWay'}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Short Quantity"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idShortQty"
                                width="100%"
                                type="Number"
                                value="{path: 'TripData>/ShortQty', mode: 'TwoWay'}"
                                placeholder="From trip / enter short qty"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Row 3: Remarks | Additional Info -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutRemarks"
                                rows="4"
                                growing="true"
                                growingMaxLines="8"
                                placeholder="Enter any remarks"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Additional Info"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutAdditionalInfo"
                                rows="4"
                                growing="true"
                                growingMaxLines="12"
                                placeholder="Enter additional information"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateOut"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateOut"
                    />
                    <Button
                        id="btnSaveGateOut"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateOut"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
