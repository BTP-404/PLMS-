<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateOut"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact sapUiSmallMargin">
        <!-- Invoice No from OData BillingDocSH (Vbeln); hidden for Inward (MovementType I) -->
        <VBox
            id="idInvoiceNoSection"
            width="50%"
            class="sapUiSmallMarginBottom"
            visible="{path: 'TripData>/MovementType', formatter: '.formatInvoiceSectionVisible'}"
        >
            <Label
                text="Invoice No"
                required="true"
                design="Bold"
                class="sapUiNoMarginBottom"
            />
            <ComboBox
                id="idInvoiceNumberDropdown"
                width="50%"
                editable="true"
                placeholder="Select invoice"
                value="{path: 'TripData>/BillingDocument', mode: 'TwoWay'}"
                selectedKey="{path: 'TripData>/BillingDocument', mode: 'TwoWay'}"
                items="{invoiceNoModel>/items}"
                filterParameter="text"
                change="onInvoiceNoChange"
            >
                <core:Item
                    key="{invoiceNoModel>Vbeln}"
                    text="{invoiceNoModel>Vbeln}"
                    templateShareable="false"
                />
            </ComboBox>
        </VBox>

        <!-- ========================================================= -->
        <!-- =============== Reference Documents (merged) ============= -->
        <!-- ========================================================= -->
        <mvc:XMLView
            id="idRefDocsViewGateOut"
            viewName="com.incresolZ_INC_PLMS.view.subview.ReferenceDocuments"
            class="sapUiTinyMarginBottom"
        />

        <!-- ========================================================= -->
        <!-- ==================== Gate Out Details ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-Out" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding">
                <!-- ========================= ROW 1 ========================= -->
                <!-- Verified Docs + Bins Returned (2 columns) -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                >
                    <!-- Verified Docs -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Verified the Documents?"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idVerifiedDocs"
                                columns="2"
                                selectedIndex="0"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>

                    <!-- Bins Returned -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Bins Returned"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idBinsReturned"
                                width="100%"
                                type="Number"
                                placeholder="Enter bins returned"
                                value="{path: 'TripData>/BinsReturned', mode: 'TwoWay'}"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 2 ========================= -->
                <!-- Exit Gate + Short Qty (ShortQty from TripDetails) -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Exit Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <ComboBox
                                id="idExitGateNumber"
                                width="100%"
                                editable="true"
                                placeholder="Select exit gate"
                                selectedKey="{path: 'TripData>/ExitGateNum', mode: 'OneWay'}"
                                items="{exitGateModel>/items}"
                            >
                                <core:Item
                                    key="{exitGateModel>ConfigID}"
                                    text="{exitGateModel>ConfigID}"
                                    templateShareable="false"
                                />
                            </ComboBox>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Short Quantity"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idShortQty"
                                width="100%"
                                type="Number"
                                value="{path: 'TripData>/ShortQty', mode: 'TwoWay'}"
                                placeholder="From trip / enter short qty"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 3 ========================= -->
                <!-- Remarks + Additional Info -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- Remarks -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Additional Info -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Additional Info"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutAdditionalInfo"
                                rows="4"
                                placeholder="Enter additional information"
                                growing="true"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiTinyMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateOut"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateOut"
                    />
                    <Button
                        id="btnSaveGateOut"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateOut"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

