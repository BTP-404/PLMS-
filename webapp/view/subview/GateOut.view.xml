<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateOut"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact" width="100%">
        <!-- Invoice No from OData BillingDocSH (Vbeln); hidden for Inward (MovementType I) -->
        <VBox
            id="idInvoiceNoSection"
            width="50%"
            class="sapUiTinyMarginBottom"
            visible="{path: 'TripData>/MovementType', formatter: '.formatInvoiceSectionVisible'}"
        >
            <Label
                text="Invoice No"
                required="true"
                design="Bold"
                class="sapUiNoMarginBottom"
            />
            <Input
                id="idInvoiceNumberDropdown"
                width="50%"
                placeholder="Select invoice"
                value="{path: 'TripData>/BillingDocument', mode: 'TwoWay'}"
                showValueHelp="true"
                valueHelpRequest="onInvoiceValueHelpRequest"
                showSuggestion="true"
                filterSuggests="false"
                suggest="onInvoiceSuggest"
                suggestionItemSelected="onInvoiceSuggestionItemSelected"
                change="onInvoiceNoChange"
            />
        </VBox>

        <!-- ========================================================= -->
        <!-- =============== Reference Documents (merged) ============= -->
        <!-- ========================================================= -->
        <mvc:XMLView
            id="idRefDocsViewGateOut"
            viewName="com.incresolZ_INC_PLMS.view.subview.ReferenceDocuments"
            class="sapUiTinyMarginBottom"
        />

        <!-- ========================================================= -->
        <!-- ==================== Gate Out Details ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-Out" class="sectionPanelTitle" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiMediumPadding plmsGateOutForm">
                <!-- Row 1: Exit Gate | Related Trip (Gate Pass No) | Verified Documents -->
                <layout:Grid
                    defaultSpan="L4 M4 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Exit Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <ComboBox
                                id="idExitGateNumber"
                                width="100%"
                                editable="true"
                                placeholder="Select exit gate"
                                selectedKey="{path: 'TripData>/ExitGateNum', mode: 'OneWay'}"
                                items="{exitGateModel>/items}"
                            >
                                <core:Item
                                    key="{exitGateModel>ConfigID}"
                                    text="{exitGateModel>ConfigID}"
                                    templateShareable="false"
                                />
                            </ComboBox>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Related Trip Number (Gate Pass No)"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idGateOutRelatedTripNumber"
                                width="100%"
                                value="{
                                    path: 'TripData>/TripNumber',
                                    formatter: '.formatTripNumber'
                                }"
                                enabled="false"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Verified the Documents?"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idVerifiedDocs"
                                columns="2"
                                selectedIndex="{path: 'TripData>/VerifiedDocs', formatter: '.formatVerifiedDocsIndex'}"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Row 2: Skip Document | Bins Returned | Short Quantity -->
                <layout:Grid
                    defaultSpan="L4 M4 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Skip Document"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idSkipDocumentGateOut"
                                columns="2"
                                selectedIndex="{path: 'TripData>/RefDocSkip', formatter: '.formatRefDocSkipIndex'}"
                                select="onRefDocSkipChange"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Bins Returned"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idBinsReturned"
                                width="100%"
                                type="Number"
                                placeholder="Enter bins returned"
                                value="{path: 'TripData>/BinsReturned', mode: 'TwoWay'}"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Short Quantity"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idShortQty"
                                width="100%"
                                type="Number"
                                value="{path: 'TripData>/ShortQty', mode: 'TwoWay'}"
                                placeholder="From trip / enter short qty"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- Row 3: Remarks | Additional Info -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="2"
                    vSpacing="2"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutRemarks"
                                rows="4"
                                growing="true"
                                growingMaxLines="8"
                                placeholder="Enter any remarks"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Additional Info"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutAdditionalInfo"
                                rows="4"
                                growing="true"
                                growingMaxLines="12"
                                placeholder="Enter additional information"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateOut"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateOut"
                    />
                    <Button
                        id="btnSaveGateOut"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateOut"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ======================= Bin Details ===================== -->
        <!-- ========================================================= -->
        <Panel
            id="idBinDetailsPanel"
            expandable="true"
            expanded="false"
            class="sapUiNoContentPadding sapUiTinyMarginBottom"
            width="100%"
            visible="{path: 'TripData>/MovementScenarioItemKey', formatter: '.formatIsO09Scenario'}"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Bin Details" class="sectionPanelTitle" />
                    <ToolbarSpacer />
                    <Button
                        text="Edit"
                        icon="sap-icon://edit"
                        type="Transparent"
                        press="onEditBinDetails"
                        visible="{= ${binState>/binDetailsEditMode} ? false : true }"
                    />
                    <Button
                        text="Save"
                        icon="sap-icon://save"
                        type="Accept"
                        press="onSaveBinDetails"
                        visible="{binState>/binDetailsEditMode}"
                        class="sapUiTinyMarginBegin"
                    />
                    <Button
                        text="Cancel"
                        icon="sap-icon://decline"
                        type="Transparent"
                        press="onCancelBinDetails"
                        visible="{binState>/binDetailsEditMode}"
                    />
                </OverflowToolbar>
            </headerToolbar>
            <VBox class="sapUiSizeCompact sapUiMediumPadding">
                <Table
                    id="idBinDetailsTable"
                    inset="false"
                    width="100%"
                    class="sapUiSizeCompact"
                    fixedLayout="true"
                    autoPopin="true"
                    popinLayout="GridSmall"
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingScrollToLoad="true"
                    growingThreshold="20"
                    items="{path: 'refDocModel>/filteredMaterialDetails'}"
                    noDataText="No bins available"
                >
                        <columns>
                            <Column
                                demandPopin="true"
                                minScreenWidth="Desktop"
                                popinDisplay="Inline"
                            >
                                <Text text="Material Description" />
                            </Column>
                            <Column
                                demandPopin="true"
                                minScreenWidth="Desktop"
                                popinDisplay="Inline"
                                hAlign="End"
                            >
                                <Text text="Bins (Trolleys)" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text
                                        text="{refDocModel>materialDescription}"
                                    />
                                    <Text
                                        text="{= ${refDocModel>binsTrolleys} || '0' }"
                                        visible="{= ${binState>/binDetailsEditMode} ? false : true }"
                                    />
                                    <Input
                                        value="{path: 'refDocModel>binsTrolleys', mode: 'TwoWay'}"
                                        type="Number"
                                        width="100%"
                                        visible="{binState>/binDetailsEditMode}"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                </Table>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
