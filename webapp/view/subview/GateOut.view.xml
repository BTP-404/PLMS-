<mvc:View controllerName="com.incresolZ_INC_PLMS.controller.Stage" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:unified="sap.ui.unified" xmlns:form="sap.ui.layout.form">
	<VBox class="sapUiSmallMargin sapUiSizeCompact">
		<!-- Gate Out Details Section -->
		<Panel headerText="Gate Out Details" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
			<form:SimpleForm id="gateOutDetailsForm" editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="1"
				emptySpanM="1" columnsL="2" columnsM="2" columnsS="1">
				<!-- Exit Gate Number -->
				<Label text="Exit Gate Number" required="true"/>
				<Select id="idExitGateNumber" required="true"/>
				<!-- Verified the Documents -->
				<Label text="Verified the Documents?" required="true"/>
				<RadioButtonGroup id="idVerifiedDocs" columns="2">
					<buttons>
						<RadioButton text="Yes" key="Y"/>
						<RadioButton text="No" key="N"/>
					</buttons>
				</RadioButtonGroup>
				<!-- Remarks -->
				<Label text="Remarks"/>
				<TextArea id="idGateOutRemarks" rows="3" placeholder="Enter remarks (optional)"/>
				<!-- Upload Attachments -->
				<Label text="Upload Attachments"/>
				<unified:FileUploader id="idGateOutAttachments" multiple="true" buttonText="Upload" fileType="jpg,png,pdf,docx"
					placeholder="Attach related documents" uploadUrl="/upload" change="onGateOutAttachmentChange"/>
			</form:SimpleForm>
			<!-- Action Buttons -->
			<HBox justifyContent="End" class="sapUiTinyMarginTop sapUiTinyMarginEnd">
				<Button id="btnEditGateOut" text="Edit" type="Emphasized" press="onEditGateOut"/>
				<Button id="btnSaveGateOut" text="Save" type="Accept" press="onSaveGateOut" class="sapUiTinyMarginBegin"/>
			</HBox>
		</Panel>
		<!-- Change History Section -->
		<Panel headerText="Change History" expandable="true" expanded="false" class="sapUiSmallMarginBottom">
			<form:SimpleForm id="gateOutHistoryForm" editable="false" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="1"
				emptySpanM="1" columnsL="2" columnsM="2" columnsS="1">
				<Label text="Created By" required="true"/>
				<Select id="idGateOutCreatedBy" required="true" enabled="false"/>
				<Label text="Created On Date" required="true"/>
				<DatePicker id="idGateOutCreatedOnDate" required="true" enabled="false"/>
				<Label text="Created On Time" required="true"/>
				<TimePicker id="idGateOutCreatedOnTime" required="true" enabled="false"/>
				<!--<Label text="Changed By"/>-->
				<!--<Select id="idGateOutChangedBy"/>-->
				<!--<Label text="Changed On Date"/>-->
				<!--<DatePicker id="idGateOutChangedOnDate"/>-->
				<!--<Label text="Changed On Time"/>-->
				<!--<TimePicker id="idGateOutChangedOnTime"/>-->
			</form:SimpleForm>
			<!-- Action Buttons -->
			<!--<HBox justifyContent="End" class="sapUiTinyMarginTop sapUiTinyMarginEnd">-->
			<!--	<Button id="btnEditGateOutHistory" text="Edit" type="Emphasized" press="onEditGateOutHistory"/>-->
			<!--	<Button id="btnSaveGateOutHistory" text="Save" type="Accept" press="onSaveGateOutHistory" class="sapUiTinyMarginBegin"/>-->
			<!--</HBox>-->
		</Panel>
	</VBox>
</mvc:View>