<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.subview.GateOut"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <VBox class="sapUiSizeCompact sapUiTinyMargin">
        <!-- ========================================================= -->
        <!-- ==================== Gate Out Details ==================== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate-Out" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <!-- ========================= ROW 1 ========================= -->
                <!-- Exit Gate + Verified Docs + Upload Attachments -->
                <layout:Grid
                    defaultSpan="L4 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                >
                    <!-- Exit Gate Number -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Exit Gate Number"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <Input
                                id="idExitGateNumber"
                                showValueHelp="true"
                                placeholder="Select Exit Gate"
                                valueHelpRequest="onExitGateValueHelp"
                                width="100%"
                                value="{
                                    path: 'TripData>/ExitGateNum',
                                    mode: 'OneWay'
                                }"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Verified Docs -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Verified the Documents?"
                                required="true"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <RadioButtonGroup
                                id="idVerifiedDocs"
                                columns="2"
                                selectedIndex="{TripData>/VerifiedDocs}"
                                width="100%"
                            >
                                <RadioButton text="Yes" />
                                <RadioButton text="No" />
                            </RadioButtonGroup>
                        </VBox>
                    </layout:content>

                    <!-- Upload Attachments -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Upload Attachments"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <HBox alignItems="Center" width="100%">
                                <unified:FileUploader
                                    id="idGateOutAttachments"
                                    multiple="true"
                                    buttonText="Choose Files"
                                    fileType="jpg,png,pdf,docx"
                                    placeholder="Attach related documents"
                                    change="onGateOutAttachmentChange"
                                    width="100%"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="idPreviewSelectedGateOutFiles"
                                    icon="sap-icon://show"
                                    tooltip="Preview Selected Files"
                                    type="Transparent"
                                    enabled="false"
                                    press="onPreviewSelectedGateOutFiles"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ========================= ROW 2 ========================= -->
                <!-- Remarks + Additional Info -->
                <layout:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="0.5rem"
                    vSpacing="0.5rem"
                    width="100%"
                    class="sapUiTinyMarginTop"
                >
                    <!-- Remarks -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Remarks"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutRemarks"
                                rows="4"
                                placeholder="Enter any remarks"
                                value="{TripData>/GateOutRemarks}"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>

                    <!-- Additional Info -->
                    <layout:content>
                        <VBox width="100%">
                            <Label
                                text="Additional Info"
                                design="Bold"
                                class="sapUiNoMarginBottom"
                            />
                            <TextArea
                                id="idGateOutAdditionalInfo"
                                rows="4"
                                placeholder="Enter additional information"
                                value="{TripData>/GateOutAdditionalInfo}"
                                growing="true"
                                width="100%"
                            />
                        </VBox>
                    </layout:content>
                </layout:Grid>

                <!-- ==================== BUTTON ROW ======================= -->
                <!-- Right aligned bottom buttons -->
                <HBox
                    justifyContent="End"
                    class="sapUiTinyMarginTop"
                    width="100%"
                >
                    <Button
                        id="btnEditGateOut"
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditGateOut"
                    />
                    <Button
                        id="btnSaveGateOut"
                        text="Save"
                        type="Accept"
                        icon="sap-icon://save"
                        press="onSaveGateOut"
                        class="sapUiTinyMarginBegin"
                    />
                </HBox>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Saved Attachments Panel =============== -->
        <!-- ========================================================= -->
        <Panel
            id="gateOutAttachmentsPanel"
            expandable="true"
            expanded="true"
            class="sapUiNoContentPadding sapUiTinyMarginTop"
        >
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Gate Out Attachments" />
                </OverflowToolbar>
            </headerToolbar>

            <VBox class="sapUiSizeCompact sapUiSmallPadding">
                <List
                    id="idGateOutAttachmentsList"
                    mode="None"
                    noDataText="No attachments uploaded yet."
                    items="{gateOutAttachmentsModel>/attachments}"
                    class="sapUiSizeCompact"
                >
                    <items>
                        <CustomListItem>
                            <HBox alignItems="Center" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom">
                                <core:Icon
                                    src="sap-icon://attachment"
                                    size="1.5rem"
                                    class="sapUiTinyMarginEnd"
                                    color="#0070f2"
                                />
                                <VBox class="sapUiTinyMarginBegin" flex="1">
                                    <Text
                                        text="{gateOutAttachmentsModel>fileName}"
                                        class="sapUiTinyMarginBottom"
                                        wrapping="true"
                                    />
                                    <Text
                                        text="{gateOutAttachmentsModel>contentType}"
                                        class="sapUiSmallFontSize"
                                        wrapping="true"
                                    />
                                </VBox>
                                <Button
                                    text="Preview"
                                    type="Emphasized"
                                    icon="sap-icon://show"
                                    press="onPreviewGateOutAttachment"
                                    class="sapUiTinyMarginBegin"
                                />
                            </HBox>
                        </CustomListItem>
                    </items>
                </List>
            </VBox>
        </Panel>

        <!-- ========================================================= -->
        <!-- ================= Change History Panel ================== -->
        <!-- ========================================================= -->
