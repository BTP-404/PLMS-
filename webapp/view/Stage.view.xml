<mvc:View controllerName="com.incresolZ_INC_PLMS.controller.Stage" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form" xmlns:unified="sap.ui.unified" xmlns:html="http://www.w3.org/1999/xhtml" displayBlock="true">
	<App>
		<pages>
			<Page id="stagePage" enableScrolling="true" class="sapUiNoContentPadding">
				<customHeader>
					<OverflowToolbar id="headerBar" class="stageHeaderBar">

						<!-- LEFT -->
						<Text
							text="Gate Pass No: {
								path: 'pageTitleModel>/tripNumber',
								formatter: '.formatTripNumber'
							}"
						/>

						<!-- SPACE PUSH -->
						<ToolbarSpacer />

						<!-- CENTER -->
						<Text
							text="Vehicle No: {pageTitleModel>/vehicleNumber}"
						/>

						<ToolbarSpacer />

						<!-- RIGHT -->
						<Text
							text="Trip status : {pageTitleModel>/tripStatus}"
							wrapping="false"
						/>

					</OverflowToolbar>
				</customHeader>
				<content>
					<VBox class="stageContentVBox" width="100%">
						<!-- Selected Scenario Info (no layout space when hidden) -->
						<Text id="selectedScenarioText" text="" class="cutstomCssSCenarioText"
							visible="false"/>
						<!-- IconTabBar -->
						<IconTabBar id="iconTabBar" class="homeLikeTabs" expandable="true" expanded="true" enableTabReordering="true" select="onIconTabSelect">
							<items>
								<IconTabFilter key="gateIn" text="Gate In" icon="sap-icon://visits" enabled="true">
									<mvc:XMLView viewName="com.incresolZ_INC_PLMS.view.subview.GateIn"/>
								</IconTabFilter>
								<IconTabFilter id="idLoadingMaterial" text="Loading" icon="sap-icon://cart-3" visible="false">
									<mvc:XMLView id="idLoadingMaterialView" viewName="com.incresolZ_INC_PLMS.view.subview.Loading"/>
								</IconTabFilter>
								<IconTabFilter id="idUnloadingMaterial" text="Unloading" icon="sap-icon://cart-2" visible="false">
									<mvc:XMLView id="idUnloadingMaterialView" viewName="com.incresolZ_INC_PLMS.view.subview.Unloading"/>
								</IconTabFilter>
								<IconTabFilter id="tabGateOut" text="Gate Out" key="gateout" icon="sap-icon://outbox" iconColor="Default">
									<mvc:XMLView viewName="com.incresolZ_INC_PLMS.view.subview.GateOut"/>
								</IconTabFilter>

								<IconTabFilter id="idActivityTab" text="Analysis" key="activity" icon="sap-icon://process" iconColor="Positive">
									<mvc:XMLView viewName="com.incresolZ_INC_PLMS.view.subview.Activity"/>
								</IconTabFilter>
								
								<IconTabFilter id="idNotesTab" text="Notes" icon="sap-icon://notes" key="Notes" iconColor="Positive">
									<mvc:XMLView viewName="com.incresolZ_INC_PLMS.view.subview.Notes"/>
								</IconTabFilter>
								<IconTabFilter id="idAttachmentTab" text="Attachments" icon="sap-icon://attachment" key="Attachments" iconColor="Positive">
									<mvc:XMLView viewName="com.incresolZ_INC_PLMS.view.subview.AttachmentsTab"/>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</VBox>
				</content>
				<!-- Footer Section -->
				<footer>
					<Bar design="Footer">
						<contentLeft>
							<Button
								id="btnCancelTrip"
								text="Cancel Trip"
								type="Reject"
								icon="sap-icon://cancel"
								press=".onCancelTrip"
								class="darkCancelButton"
							/>
						</contentLeft>
					</Bar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>