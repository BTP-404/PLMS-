<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.HomePage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:semantic="sap.f.semantic"
    displayBlock="true"
>
    <semantic:SemanticPage
        id="TripSemanticPage"
        toggleHeaderOnTitleClick="true"
        preserveHeaderStateOnScroll="true"
        showFooter="false"
    >
        <!-- ==================== TITLE AREA ==================== -->
        <semantic:titleHeading>
            <Title
                text="Trip Status"
                level="H5"
            />
        </semantic:titleHeading>
        <!-- ==================== TITLE ACTIONS ==================== -->
        <semantic:titleCustomTextActions>
            <Button
                id="btnReportVehicle"
                text="Report Vehicle"
                icon="sap-icon://add"
                press=".onReportVehicle"
                tooltip="Report an unassigned vehicle"
            />
        </semantic:titleCustomTextActions>
        <semantic:titleCustomTextActions>
            <Button
                icon="sap-icon://refresh"
                type="Transparent"
                press=".onRefresh"
                tooltip="Refresh Table"
            />
        </semantic:titleCustomTextActions>
        <!-- ==================== HEADER FILTER AREA ==================== -->
        <semantic:headerContent>
            <layout:Grid
                defaultSpan="L3 M6 S12"
                hSpacing="1"
                vSpacing="1"
                class="sapUiSizeCompact"
            >
                <!-- Vehicle Number -->
                <layout:content>
                    <VBox>
                        <Label
                            design="Bold"
                            text="Vehicle Number:"
                        />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            showSuggestion="true"
                            suggest=".onSuggest"
                            filterSuggests="false"
                            suggestThreshold="1"
                            valueHelpRequest=".onValueHelpRequest"
                            suggestionItemSelected=".onSuggestionItemSelected"
                        >
                            <customData>
                                <core:CustomData
                                    key="field"
                                    value="vehicleNumber"
                                />
                            </customData>
                        </Input>
                    </VBox>
                </layout:content>
                <!-- Plant -->
                <layout:content>
                    <VBox>
                        <Label
                            design="Bold"
                            text="Plant:"
                        />
                        <Input
                            width="100%"
                            showValueHelp="true"
                            showSuggestion="true"
                            suggest=".onSuggest"
                            filterSuggests="false"
                            suggestThreshold="1"
                            valueHelpRequest=".onValueHelpRequest"
                            suggestionItemSelected=".onSuggestionItemSelected"
                        >
                            <customData>
                                <core:CustomData
                                    key="field"
                                    value="plant"
                                />
                            </customData>
                        </Input>
                    </VBox>
                </layout:content>
                <!-- Report Date From -->
                <layout:content>
                    <VBox>
                        <Label
                            design="Bold"
                            text="Report Date From:"
                        />
                        <DatePicker
                            id="ReportDateFrom" 
                            width="100%"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="medium"
                        >
                            <customData>
                                <core:CustomData
                                    key="field"
                                    value="reportDateFrom"
                                />
                            </customData>
                        </DatePicker>
                    </VBox>
                </layout:content>
                <!-- Report Date To + Go -->
             <!-- Report Date To + Go -->
<layout:content>
    <VBox>
        <Label design="Bold" text="Report Date To:" />
        <HBox
            alignItems="Center"
            width="100%"
        >
            <DatePicker
                id="ReportDateTo"
                width="100%"
                valueFormat="yyyy-MM-dd"
                displayFormat="medium"
            >
                <layoutData>
                    <FlexItemData growFactor="1" />
                </layoutData>
            </DatePicker>

            <Button
                text="Go"
                type="Emphasized"
                width="3rem"
                press=".onGoPress"
                class="sapUiTinyMarginBegin"
            />
        </HBox>
    </VBox>
</layout:content>

            </layout:Grid>
        </semantic:headerContent>
        <!-- ==================== CONTENT AREA ==================== -->
        <semantic:content>
            <ScrollContainer
                width="100%"
                horizontal="true"
                vertical="false"
                height="auto"
            >
                <Table
                    id="tripTable"
                    inset="false"
                    mode="SingleSelectMaster"
                    items="{
                        path: '/TripDetails'
                    }"
                    headerText="Trip Details"
                    class="sapUiSizeCompact"
                    growing="true"
                    growingScrollToLoad="false"
                    growingThreshold="25"
                    sticky="ColumnHeaders,HeaderToolbar"
                    width="auto"
                    autoPopin="true"
                    fixedLayout="false"
                    selectionChange="onTripPress"
                >
                    <headerToolbar>
                    <Toolbar>
                        <Title text="Trip Details" />
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://action-settings"
                            type="Transparent"
                            press=".onOpenColumnVisibilityDialog"
                            tooltip="Column Settings"
                        />
                    </Toolbar>
                </headerToolbar>
                    <columns>
                        <Column
                            id="colTripNumber"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Trip Number" />
                        </Column>
                        <Column
                            id="colVehicleNumber"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Vehicle Number" />
                        </Column>
                        <Column
                            id="colTripStatus"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Trip Status" />
                        </Column>
                        <Column
                            id="colVehicleType"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Vehicle Type" />
                        </Column>
                        <Column
                            id="colVehicleSize"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Vehicle Size" />
                        </Column>
                        <Column
                            id="colTransporterName"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Transporter Name" />
                        </Column>
                        <Column
                            id="colLRNumber"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="LR Number" />
                        </Column>
                        <Column
                            id="colLRDate"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="LR Date" />
                        </Column>
                        <Column
                            id="colDriverName"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Driver Name" />
                        </Column>
                        <Column
                            id="colDriverMobile"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Driver Mobile" />
                        </Column>
                        <Column
                            id="colCompanyCode"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Company Code" />
                        </Column>
                        <Column
                            id="colPlant"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Plant" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem 
                            vAlign="Middle"
                            class="{
                                path: 'TripStatus',
                                formatter: '.getTripStatusClass'
                            }">
                            <cells>
                                <Text
                                    text="{
                                        path: 'TripNumber',
                                        formatter: '.formatTripNumber'
                                    }"
                                    wrapping="true"
                                />
                                <Text
                                    text="{VehicleNumber}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{TripStatus}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{VehicleType}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{VehicleSize}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{TransporterName}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{LR_Number}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{
                                        path: 'LR_Date',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                            pattern: 'dd-MM-yyyy'
                                        }
                                    }"
                                    wrapping="true"
                                />
                                <Text
                                    text="{DriverName}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{DriverMobile}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{CompanyCode}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{Plant}"
                                    wrapping="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </semantic:content>
    </semantic:SemanticPage>
</mvc:View>
