<mvc:View
    controllerName="com.incresolZ_INC_PLMS.controller.HomePage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:semantic="sap.f.semantic"
    displayBlock="true"
>
    <semantic:SemanticPage
        id="TripSemanticPage"
        class="homeSemanticPage"
        toggleHeaderOnTitleClick="true"
        preserveHeaderStateOnScroll="true"
        headerPinnable="true"
        showFooter="false"
    >
        <!-- ==================== TITLE AREA ==================== -->
        <semantic:titleHeading>
            <Title
                text="Trip Status"
                level="H5"
                class="homePageTitle"
            />
        </semantic:titleHeading>
        <!-- ==================== TITLE ACTIONS ==================== -->
        <semantic:titleCustomTextActions>
            <Button
                id="btnReportVehicle"
                text="Report Vehicle"
                icon="sap-icon://add"
                press=".onReportVehicle"
                tooltip="Report an unassigned vehicle"
                class="btnReportVehicle"
            />
        </semantic:titleCustomTextActions>
        <semantic:titleCustomTextActions>
            <Button
                icon="sap-icon://refresh"
                type="Transparent"
                press=".onRefresh"
                tooltip="Refresh Table"
            />
        </semantic:titleCustomTextActions>
        <!-- ==================== HEADER FILTER AREA ==================== -->
        <semantic:headerContent>
            <layout:Grid
                width="100%"
                defaultSpan="XL3 L3 M4 S12"
                hSpacing="2"
                vSpacing="1"
                class="sapUiSizeCompact homeFilterCard"
            >
                <!-- Trip Number -->
                <layout:content>
                    <VBox>
                        <layoutData>
                            <layout:GridData span="XL3 L3 M4 S12" />
                        </layoutData>
                        <Label
                            design="Bold"
                            text="Trip Number:"
                        />
                        <Input
                            width="100%"
                            showSuggestion="true"
                            suggest=".onSuggest"
                            filterSuggests="false"
                            suggestThreshold="1"
                            suggestionItemSelected=".onSuggestionItemSelected"
                        >
                            <customData>
                                <core:CustomData
                                    key="field"
                                    value="tripNo"
                                />
                            </customData>
                        </Input>
                    </VBox>
                </layout:content>
                <!-- Vehicle Number -->
                <layout:content>
                    <VBox>
                        <layoutData>
                            <layout:GridData span="XL3 L3 M4 S12" />
                        </layoutData>
                        <Label
                            design="Bold"
                            text="Vehicle Number:"
                        />
                        <Input
                            width="100%"
                            showSuggestion="true"
                            suggest=".onSuggest"
                            filterSuggests="false"
                            suggestThreshold="1"
                            suggestionItemSelected=".onSuggestionItemSelected"
                        >
                            <customData>
                                <core:CustomData
                                    key="field"
                                    value="vehicleNumber"
                                />
                            </customData>
                        </Input>
                    </VBox>
                </layout:content>
                <!-- Report date range + Go: wider column (5/12) so range + Go fit; row 11/12 leaves light margin on right -->
                <layout:content>
                    <VBox>
                        <layoutData>
                            <layout:GridData span="XL5 L5 M4 S12" />
                        </layoutData>
                        <Label
                            design="Bold"
                            text="Vehicle Reported Date Range:"
                        />
                        <HBox
                            alignItems="Center"
                            width="100%"
                            justifyContent="Start"
                        >
                            <DateRangeSelection
                                id="ReportDateRange"
                                width="100%"
                                displayFormat="medium"
                                placeholder="{i18n>dateRangePlaceholderExample}"
                                showCurrentDateButton="true"
                                showFooter="true"
                                change=".onReportDateRangeChange"
                                value="{
                                    parts: [
                                        { path: 'homeFilter>/reportDateFrom', type: 'sap.ui.model.type.Date' },
                                        { path: 'homeFilter>/reportDateTo', type: 'sap.ui.model.type.Date' }
                                    ],
                                    type: 'sap.ui.model.type.DateInterval'
                                }"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </DateRangeSelection>
                            <Button
                                text="Go"
                                type="Emphasized"
                                width="3rem"
                                press=".onGoPress"
                                class="sapUiSmallMarginBegin"
                            />
                        </HBox>
                    </VBox>
                </layout:content>

            </layout:Grid>
        </semantic:headerContent>
        <!-- ==================== CONTENT AREA ==================== -->
        <semantic:content>
            <ScrollContainer
                width="100%"
                horizontal="false"
                vertical="false"
                height="auto"
                class="homePageContent homeTripScrollContainer"
            >
                <Table
                    id="tripTable"
                    inset="false"
                    mode="SingleSelectMaster"
                    items="{
                        path: '/TripDetails'
                    }"
                    headerText="Trip Details"
                    class="sapUiSizeCompact homeTripTable"
                    growing="true"
                    growingScrollToLoad="false"
                    growingThreshold="25"
                    sticky="ColumnHeaders,HeaderToolbar"
                    width="100%"
                    autoPopin="true"
                    fixedLayout="false"
                    selectionChange="onTripPress"
                >
                    <headerToolbar>
                    <Toolbar>
                        <Title text="Trip Details" class="sectionPanelTitle" />
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://action-settings"
                            type="Transparent"
                            press=".onOpenColumnVisibilityDialog"
                            tooltip="Column Settings"
                        />
                    </Toolbar>
                </headerToolbar>
                    <columns>
                        <Column
                            id="colTripNumber"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Trip Number" />
                        </Column>
                        <Column
                            id="colVehicleNumber"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Vehicle Number" />
                        </Column>
                        <Column
                            id="colTripStatus"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Trip Status" />
                        </Column>
                        <Column
                            id="colMovementType"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            popinDisplay="Inline"
                        >
                            <Text text="Movement Type" />
                        </Column>
                        <Column
                            id="colVehicleType"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Vehicle Type" />
                        </Column>
                        <Column
                            id="colVehicleSize"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Vehicle Size" />
                        </Column>
                        <Column
                            id="colTransporterName"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Transporter Name" />
                        </Column>
                        <Column
                            id="colLRNumber"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="LR Number" />
                        </Column>
                        <Column
                            id="colLRDate"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="LR Date" />
                        </Column>
                        <Column
                            id="colDriverName"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Driver Name" />
                        </Column>
                        <Column
                            id="colDriverMobile"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                            popinDisplay="Inline"
                        >
                            <Text text="Driver Mobile" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem 
                            vAlign="Middle"
                            class="{
                                path: 'TripStatus',
                                formatter: '.getTripStatusClass'
                            }">
                            <cells>
                                <Text
                                    text="{
                                        path: 'TripNumber',
                                        formatter: '.formatTripNumber'
                                    }"
                                    wrapping="true"
                                />
                                <Text
                                    text="{VehicleNumber}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{TripStatus}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{
                                        path: 'MovementType',
                                        formatter: '.formatMovementType'
                                    }"
                                    wrapping="true"
                                />
                                <Text
                                    text="{VehicleType}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{VehicleSize}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{TransporterName}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{LR_Number}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{
                                        path: 'LR_Date',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                            style: 'medium'
                                        }
                                    }"
                                    wrapping="true"
                                />
                                <Text
                                    text="{DriverName}"
                                    wrapping="true"
                                />
                                <Text
                                    text="{DriverMobile}"
                                    wrapping="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </semantic:content>
    </semantic:SemanticPage>
</mvc:View>
