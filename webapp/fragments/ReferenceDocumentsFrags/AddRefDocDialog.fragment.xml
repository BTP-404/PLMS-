<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idAddRefDocDialog"
        title="Add Reference Document"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1"
        >
            <Label text="Doc Type" />
            <Select
                id="idRefDocType"
                change=".onDocTypeChange"
                items="{docTypeModel>/items}"
                forceSelection="false"
            >
                <core:Item
                    key="{docTypeModel>ConfigID}"
                    text="{= ${docTypeModel>ConfigID} + ' - ' + ${docTypeModel>Description}}"
                    additionalText="{docTypeModel>Description}"
                />
            </Select>

            <Label text="Document Number" />
            <ComboBox
                id="idRefDocNumber"
                valueLiveUpdate="true"
                allowCustomValue="true"
                showSuggestion="true"
                filterSuggests="false"
                suggest=".onRefDocNumberSuggest"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                showSecondaryValues="true"
                filterSecondaryValues="true"
                selectionChange=".onRefDocSuggestionSelected"
                items="{
                    path: 'refDocSuggestions>/items',
                    sorter: { path: 'DocumentNumber' }
                }"
            >
                <core:ListItem
                    key="{refDocSuggestions>DocumentNumber}"
                    text="{refDocSuggestions>DocumentNumber}"
                    additionalText="{refDocSuggestions>Name}"
                />
            </ComboBox>

            <Label text="Document Date" />
            <DatePicker
                id="idRefDocDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="medium"
                placeholder="{i18n>datePlaceholderExample}"
                editable="false"
            />

            <Label text="Sending / Receiving Party Code" />
            <Input
                id="idRefDocPartyCode"
                valueLiveUpdate="true"
                editable="false"
            />

            <Label text="Sending / Receiving Party Name" />
            <Input
                id="idRefDocPartyName"
                valueLiveUpdate="true"
                editable="false"
            />

            <Label text="EwayBill Number" />
            <Input
                id="idRefDocEwayBillNumber"
                valueLiveUpdate="true"
                editable="false"
            />

            <Label text="EwayBill Date" />
            <DatePicker
                id="idRefDocEwayBillDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="medium"
                placeholder="{i18n>datePlaceholderExample}"
                editable="false"
            />

            <Label text="Order Number" />
            <Input
                id="idRefDocSalesDoc"
                valueLiveUpdate="true"
                editable="false"
            />

            <Label text="Order Type" />
            <Input
                id="idRefDocSalesDoctype"
                valueLiveUpdate="true"
                editable="false"
            />

        </form:SimpleForm>

        <beginButton>
            <Button
                id="idRefDocDialogSaveBtn"
                text="Add"
                type="Emphasized"
                press=".onSaveRefDocDialog"
                visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} ? false : true }"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelRefDocDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

