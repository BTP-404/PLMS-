<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idAddRefDocDialog"
        title="Add Reference Document"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1"
        >
            <Label text="Doc Type" />
            <Input id="idRefDocType" valueLiveUpdate="true" />

            <Label text="Document Number" />
            <Input id="idRefDocNumber" valueLiveUpdate="true" />

            <Label text="Document Date" />
            <DatePicker
                id="idRefDocDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
            />

            <Label text="Party Code" />
            <Input id="idRefDocPartyCode" valueLiveUpdate="true" />

            <Label text="Party Name" />
            <Input id="idRefDocPartyName" valueLiveUpdate="true" />

            <Label text="Created By" />
            <Input id="idRefDocCreatedBy" valueLiveUpdate="true" />

            <Label text="Created On Date" />
            <DatePicker
                id="idRefDocCreatedOnDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
            />

            <Label text="Created On Time" />
            <TimePicker
                id="idRefDocCreatedOnTime"
                valueFormat="HH:mm:ss"
                displayFormat="HH:mm"
            />

            <Label text="Changed By" />
            <Input id="idRefDocChangedBy" valueLiveUpdate="true" />

            <Label text="Changed On Date" />
            <DatePicker
                id="idRefDocChangedOnDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
            />

            <Label text="Changed On Time" />
            <TimePicker
                id="idRefDocChangedOnTime"
                valueFormat="HH:mm:ss"
                displayFormat="HH:mm"
            />
        </form:SimpleForm>

        <beginButton>
            <Button
                text="Add"
                type="Emphasized"
                press=".onSaveRefDocDialog"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelRefDocDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

