<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idAddRefDocDialog"
        title="Add Reference Document"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1"
        >
            <Label text="Doc Type" />
            <Input
                id="idRefDocType"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onDocTypeValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onDocTypeSuggestionSelected"
                suggestionItems="{docTypeModel>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{docTypeModel>ConfigID}"
                        text="{docTypeModel>ConfigID}"
                        additionalText="{docTypeModel>Description}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Document Number" />
            <Input
                id="idRefDocNumber"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{refDocSuggestions>DocumentNumber}"
                        text="{refDocSuggestions>DocumentNumber}"
                        additionalText="{refDocSuggestions>DocType}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Document Date" />
            <DatePicker
                id="idRefDocDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
                enabled="false"
            />

            <Label text="Sending / Receiving Party Code" />
            <Input
                id="idRefDocPartyCode"
                valueLiveUpdate="true"
                enabled="false"
            />

            <Label text="Sending / Receiving Party Name" />
            <Input
                id="idRefDocPartyName"
                valueLiveUpdate="true"
                enabled="false"
            />

            <Label text="Sales Order Number" />
            <Input
                id="idRefDocSalesDoc"
                valueLiveUpdate="true"
                enabled="false"
            />

            <Label text="Sales Order Type" />
            <Input
                id="idRefDocSalesDoctype"
                valueLiveUpdate="true"
                enabled="false"
            />

        </form:SimpleForm>

        <beginButton>
            <Button
                id="idRefDocDialogSaveBtn"
                text="Add"
                type="Emphasized"
                press=".onSaveRefDocDialog"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelRefDocDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

