<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idAddRefDocDialog"
        title="Add Reference Document"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1"
        >
            <Label text="Doc Type" />
            <Input
                id="idRefDocType"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{refDocSuggestions>DocType}"
                        text="{refDocSuggestions>DocType}"
                        additionalText="{refDocSuggestions>DocumentNumber}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Document Number" />
            <Input
                id="idRefDocNumber"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{refDocSuggestions>DocumentNumber}"
                        text="{refDocSuggestions>DocumentNumber}"
                        additionalText="{refDocSuggestions>DocType}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Document Date" />
            <DatePicker
                id="idRefDocDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
            />

            <Label text="Party Code" />
            <Input
                id="idRefDocPartyCode"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{refDocSuggestions>Vendor}"
                        text="{refDocSuggestions>Vendor}"
                        additionalText="{refDocSuggestions>DocumentNumber}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Party Name" />
            <Input
                id="idRefDocPartyName"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{path: 'refDocSuggestions>Name'}"
                        text="{path: 'refDocSuggestions>Name'}"
                        additionalText="{refDocSuggestions>DocumentNumber}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Created By" />
            <Input
                id="idRefDocCreatedBy"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{refDocSuggestions>CreatedBy}"
                        text="{refDocSuggestions>CreatedBy}"
                        additionalText="{refDocSuggestions>DocumentNumber}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Created On Date" />
            <DatePicker
                id="idRefDocCreatedOnDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
            />

            <Label text="Created On Time" />
            <TimePicker
                id="idRefDocCreatedOnTime"
                valueFormat="HH:mm:ss"
                displayFormat="HH:mm"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
            />

            <Label text="Changed By" />
            <Input
                id="idRefDocChangedBy"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onRefDocSuggestionSelected"
                suggestionItems="{refDocSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{refDocSuggestions>ChangedBy}"
                        text="{refDocSuggestions>ChangedBy}"
                        additionalText="{refDocSuggestions>DocumentNumber}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Changed On Date" />
            <DatePicker
                id="idRefDocChangedOnDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
            />

            <Label text="Changed On Time" />
            <TimePicker
                id="idRefDocChangedOnTime"
                valueFormat="HH:mm:ss"
                displayFormat="HH:mm"
                showValueHelp="true"
                valueHelpRequest=".onRefDocValueHelp"
            />
        </form:SimpleForm>

        <beginButton>
            <Button
                text="Add"
                type="Emphasized"
                press=".onSaveRefDocDialog"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelRefDocDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

