<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="materialColumnVisibilityDialog"
        title="Material Details - Column Settings"
        contentWidth="350px"
    >
        <content>
            <List
                items="{
                    path: 'materialColumnSettings>/columns'
                }"
            >
                <CustomListItem>
                    <HBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                    >
                        <Text text="{materialColumnSettings>label}" />
                        <Switch
                            state="{materialColumnSettings>visible}"
                            change=".onMaterialColumnSwitchChanged"
                        />
                    </HBox>
                </CustomListItem>
            </List>
        </content>
        <beginButton>
            <Button
                text="Reset"
                press=".onResetMaterialColumnVisibility"
            />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseMaterialColumnVisibilityDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

