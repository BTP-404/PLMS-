<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="idSelectMaterialsDialog"
        title="Select Materials"
        class="sapUiResponsivePadding--content"
        contentWidth="60rem"
    >
        <content>
            <Table
                id="idMaterialsSelectionTable"
                items="{materialsSelectionModel>/items}"
                mode="MultiSelect"
                sticky="ColumnHeaders"
                class="sapUiSizeCompact"
                fixedLayout="false"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title text="Available Materials" level="H6"/>
                        <ToolbarSpacer/>
                        <SearchField
                            width="18rem"
                            placeholder="Search material"
                            search=".onSearchSelectMaterials"
                            liveChange=".onSearchSelectMaterials"
                        />
                        <Text text="{materialsSelectionModel>/selectedCount}" class="sapUiSmallMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="Material Code" />
                    </Column>
                    <Column>
                        <Text text="Material Description" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="Quantity" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="ShippingQty" />
                    </Column>
                    <Column hAlign="End">
                        <Text text="RemainQty" />
                    </Column>
                    <Column>
                        <Text text="UoM" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{materialsSelectionModel>MaterialCode}" />
                            <Text text="{materialsSelectionModel>MaterialDescription}" />
                            <Text text="{materialsSelectionModel>Quantity}" />
                            <Input
                                value="{materialsSelectionModel>ShippingQty}"
                                type="Number"
                                valueLiveUpdate="true"
                                liveChange=".onSelectMaterialShippingQtyLiveChange"
                                editable="{= !${globalData>/TripLocked} }"
                            />
                            <Text text="{materialsSelectionModel>RemainQty}" />
                            <Text text="{materialsSelectionModel>UoM}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button
                id="idAddSelectedMaterialsBtn"
                text="Add Selected Materials"
                type="Emphasized"
                press=".onAddSelectedMaterials"
                visible="{= ${globalData>/IsScanningReporting} || ${globalData>/DisableRefDocMaterialsActions} || ${globalData>/TripLocked} ? false : true }"
            />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseSelectMaterialsDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
