<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="refDocColumnVisibilityDialog"
        title="Reference Documents - Column Settings"
        contentWidth="350px"
    >
        <content>
            <List
                items="{
                    path: 'refDocColumnSettings>/columns'
                }"
            >
                <CustomListItem>
                    <HBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                    >
                        <Text text="{refDocColumnSettings>label}" />
                        <Switch
                            state="{refDocColumnSettings>visible}"
                            change=".onRefDocColumnSwitchChanged"
                        />
                    </HBox>
                </CustomListItem>
            </List>
        </content>
        <beginButton>
            <Button
                text="Reset"
                press=".onResetRefDocColumnVisibility"
            />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseRefDocColumnVisibilityDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

