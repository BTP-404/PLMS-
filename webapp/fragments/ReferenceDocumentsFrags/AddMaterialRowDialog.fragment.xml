<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idAddMaterialDialog"
        title="Add Material Row"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1"
        >
            <Label text="Ref Doc Number" />
            <Input
                id="idMaterialRefDocNo"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>RefDocNo}"
                        text="{materialSuggestions>RefDocNo}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Ref Doc Item Number" />
            <Input
                id="idMaterialRefDocItem"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>RefDocItemNo}"
                        text="{materialSuggestions>RefDocItemNo}"
                        additionalText="{materialSuggestions>RefDocNo}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Material Code" />
            <Input
                id="idMaterialCode"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>MaterialCode}"
                        text="{materialSuggestions>MaterialCode}"
                        additionalText="{materialSuggestions>MaterialDescription}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Material Description" />
            <Input
                id="idMaterialDesc"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>MaterialDescription}"
                        text="{materialSuggestions>MaterialDescription}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Quantity" />
            <Input
                id="idMaterialQty"
                type="Number"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>Quantity}"
                        text="{materialSuggestions>Quantity}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="UoM" />
            <Input
                id="idMaterialUoM"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>UoM}"
                        text="{materialSuggestions>UoM}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Created By" />
            <Input
                id="idMaterialCreatedBy"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>CreatedBy}"
                        text="{materialSuggestions>CreatedBy}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Created On Date" />
            <DatePicker
                id="idMaterialCreatedOnDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
            />

            <Label text="Created On Time" />
            <TimePicker
                id="idMaterialCreatedOnTime"
                valueFormat="HH:mm:ss"
                displayFormat="HH:mm"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
            />

            <Label text="Changed By" />
            <Input
                id="idMaterialChangedBy"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>ChangedBy}"
                        text="{materialSuggestions>ChangedBy}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Changed On Date" />
            <DatePicker
                id="idMaterialChangedOnDate"
                valueFormat="yyyy-MM-dd"
                displayFormat="long"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
            />

            <Label text="Changed On Time" />
            <TimePicker
                id="idMaterialChangedOnTime"
                valueFormat="HH:mm:ss"
                displayFormat="HH:mm"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
            />
        </form:SimpleForm>

        <beginButton>
            <Button
                text="Add"
                type="Emphasized"
                press=".onSaveMaterialDialog"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelMaterialDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

