<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idAddMaterialDialog"
        title="Add Material Row"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1"
        >
            <Label text="Doc Type" />
            <Input
                id="idMaterialDocType"
                showValueHelp="true"
                valueHelpRequest=".onMaterialDocTypeValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                change=".onMaterialDocTypeChange"
                suggestionItemSelected=".onMaterialDocTypeSuggestionSelected"
                suggestionItems="{docTypeModel>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{docTypeModel>ConfigID}"
                        text="{docTypeModel>ConfigID}"
                        additionalText="{docTypeModel>Description}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Ref Doc Number" />
            <Input
                id="idMaterialRefDocNo"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>RefDocNo}"
                        text="{materialSuggestions>RefDocNo}"
                        additionalText="{materialSuggestions>MaterialCode}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Ref Doc Item Number" />
            <Input
                id="idMaterialRefDocItem"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>RefDocItemNo}"
                        text="{materialSuggestions>RefDocItemNo}"
                        additionalText="{materialSuggestions>RefDocNo}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Material Code" />
            <Input
                id="idMaterialCode"
                valueLiveUpdate="true"
                showValueHelp="true"
                valueHelpRequest=".onMaterialValueHelp"
                showSuggestion="true"
                filterSuggests="true"
                suggestionItemSelected=".onMaterialSuggestionSelected"
                suggestionItems="{materialSuggestions>/items}"
            >
                <suggestionItems>
                    <core:Item
                        key="{materialSuggestions>MaterialCode}"
                        text="{materialSuggestions>MaterialCode}"
                        additionalText="{materialSuggestions>MaterialDescription}"
                        templateShareable="false"
                    />
                </suggestionItems>
            </Input>

            <Label text="Material Description" />
            <Input
                id="idMaterialDesc"
                valueLiveUpdate="true"
            />

            <Label text="Quantity" />
            <Input
                id="idMaterialQty"
                type="Number"
                valueLiveUpdate="true"
            />

            <Label text="UoM" />
            <Input
                id="idMaterialUoM"
                valueLiveUpdate="true"
            />

        </form:SimpleForm>

        <beginButton>
            <Button
                id="idMaterialDialogSaveBtn"
                text="Add"
                type="Emphasized"
                press=".onSaveMaterialDialog"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelMaterialDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

