<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="incomingEntryMethodDialog"
        title="Report Vehicle"
        contentWidth="40rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true"
        class="incomingMaterialsDialog plmsRvDialog"
        afterOpen=".onIncomingEntryMethodDialogAfterOpen"
    >
        <content>
            <VBox width="100%" class="sapUiResponsivePadding">

                <!-- Movement Type -->
                <Label
                    text="Movement Type"
                    labelFor="idReportVehicleMovementGroup"
                    type="Bold"
                />
                <RadioButtonGroup
                    id="idReportVehicleMovementGroup"
                    selectedIndex="{reportVehicleMatOpts>/selectedIndex}"
                    select=".onReportVehicleMaterialRadioSelect"
                    
                >
                    <RadioButton text="Incoming Materials" />
                    <RadioButton text="Outgoing Materials" />
                </RadioButtonGroup>

                <!-- ========== Incoming (same layout order as before) ========== -->
                <!-- Search By Panel -->
                <Panel
                    expandable="false"
                    backgroundDesign="Transparent"
                    visible="{= ${reportVehicleMatOpts>/selectedIndex} === 0 }"
                    class="sapUiNoContentPadding plmsRvSection"
                >
                    <headerToolbar>
                        <Toolbar design="Transparent">
                            <Title text="Search by" level="H5" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Select
                            id="idIncomingEntrySearchSelect"
                            width="100%"
                            selectedKey="{incomingEntryMethod>/selectedKey}"
                            change=".onIncomingEntryMethodSelectChange"
                        >
                            <core:ListItem key="PO" text="PO number" />
                            <core:ListItem key="SCAN" text="Scan D-Note" />
                        </Select>
                    </content>
                </Panel>

                <!-- PO Panel -->
                <Panel
                    expandable="false"
                    backgroundDesign="Transparent"
                    visible="{= ${reportVehicleMatOpts>/selectedIndex} === 0 &amp;&amp; ${incomingEntryMethod>/selectedKey} === 'PO' }"
                    class="sapUiNoContentPadding plmsRvSection"
                >
                    <headerToolbar>
                        <Toolbar design="Transparent">
                            <Title text="Purchase order" level="H5" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <HBox alignItems="Center" width="100%" class="sapUiTinyMarginTop plmsRvScanRow" wrap="Wrap">

                            <Input
                                id="idIncomingDialogPoInput"
                                width="100%"
                                placeholder="Type PO number"
                                showSuggestion="true"
                                suggestionItems="{incomingPoSuggest>/items}"
                                suggest=".onIncomingDialogPoSuggest"
                                suggestionItemSelected=".onIncomingDialogPoSuggestionSelected"
                                class="sapUiTinyMarginEnd plmsRvFieldGrow plmsRvScanInput"
                            >
                                <suggestionItems>
                                    <SuggestionItem
                                        text="{incomingPoSuggest>Ebeln}"
                                        description="{incomingPoSuggest>VendorName}"
                                    />
                                </suggestionItems>
                            </Input>

                            <CheckBox
                                id="idIncomingSkipDocument"
                                text="Skip Document"
                                selected="{incomingEntryMethod>/skipDocument}"
                                class="plmsRvCheckbox"
                            />

                        </HBox>
                    </content>
                </Panel>

                <!-- Scan Panel -->
                <Panel
                    expandable="false"
                    backgroundDesign="Transparent"
                    visible="{= ${reportVehicleMatOpts>/selectedIndex} === 0 &amp;&amp; ${incomingEntryMethod>/selectedKey} === 'SCAN' }"
                    class="sapUiNoContentPadding plmsRvSection"
                >
                    <headerToolbar>
                        <Toolbar design="Transparent">
                            <Title text="Delivery note" level="H5" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Text
                            text="Scan the D-Note or type the code."
                        />

                        <HBox alignItems="Stretch" width="100%" class="sapUiTinyMarginTop plmsRvScanRow">
                            <Input
                                id="idIncomingDialogScanInput"
                                width="100%"
                                placeholder="Scan / Enter code"
                                change=".onIncomingDialogScanChange"
                                class="plmsRvFieldGrow plmsRvScanInput"
                            />

                            <Button
                                icon="sap-icon://bar-code"
                                type="Emphasized"
                                press=".onIncomingDialogScanPress"
                                tabIndex="-1"
                                class="plmsRvScannerBtn plmsRvScanBtn"
                            />
                        </HBox>
                    </content>
                </Panel>

                <!-- ========== Outgoing (mirror Incoming: Search by → detail row with Skip Document) ========== -->
                <Panel
                    expandable="false"
                    backgroundDesign="Transparent"
                    visible="{= ${reportVehicleMatOpts>/selectedIndex} === 1 }"
                    class="sapUiNoContentPadding plmsRvSection"
                >
                    <headerToolbar>
                        <Toolbar design="Transparent">
                            <Title text="Search by" level="H5" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Select
                            id="idOutgoingEntrySearchSelect"
                            width="100%"
                            selectedKey="{outgoingEntryMethod>/selectedKey}"
                            change=".onOutgoingEntryMethodSelectChange"
                        >
                            <core:ListItem key="INVOICE" text="Invoice" />
                            <core:ListItem key="PO" text="PO number" />
                        </Select>
                    </content>
                </Panel>

                <Panel
                    expandable="false"
                    backgroundDesign="Transparent"
                    visible="{= ${reportVehicleMatOpts>/selectedIndex} === 1 &amp;&amp; ${outgoingEntryMethod>/selectedKey} === 'INVOICE' }"
                    class="sapUiNoContentPadding plmsRvSection"
                >
                    <headerToolbar>
                        <Toolbar design="Transparent">
                            <Title text="Invoice" level="H5" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <HBox alignItems="Center" width="100%" class="sapUiTinyMarginTop plmsRvScanRow" wrap="Wrap">
                            <Input
                                id="idOutgoingDialogInvoiceInput"
                                width="100%"
                                placeholder="Type or select invoice"
                                value="{outgoingEntryMethod>/billingDocument}"
                                showSuggestion="true"
                                filterSuggests="false"
                                suggestionItems="{outgoingInvoiceSuggest>/items}"
                                suggest=".onOutgoingReportInvoiceSuggest"
                                suggestionItemSelected=".onOutgoingReportInvoiceSuggestionSelected"
                                change=".onOutgoingReportInvoiceChange"
                                class="sapUiTinyMarginEnd plmsRvFieldGrow plmsRvScanInput"
                            >
                                <suggestionItems>
                                    <SuggestionItem
                                        text="{outgoingInvoiceSuggest>BillingDoc}"
                                        description="{outgoingInvoiceSuggest>MovementDescription}"
                                    />
                                </suggestionItems>
                            </Input>
                            <CheckBox
                                id="idOutgoingSkipDocumentInvoice"
                                text="Skip Document"
                                selected="{outgoingEntryMethod>/skipDocumentInvoice}"
                                class="plmsRvCheckbox"
                            />
                        </HBox>
                    </content>
                </Panel>

                <Panel
                    expandable="false"
                    backgroundDesign="Transparent"
                    visible="{= ${reportVehicleMatOpts>/selectedIndex} === 1 &amp;&amp; ${outgoingEntryMethod>/selectedKey} === 'PO' }"
                    class="sapUiNoContentPadding plmsRvSection"
                >
                    <headerToolbar>
                        <Toolbar design="Transparent">
                            <Title text="Purchase order" level="H5" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <HBox alignItems="Center" width="100%" class="sapUiTinyMarginTop plmsRvScanRow" wrap="Wrap">
                            <Input
                                id="idOutgoingDialogPoInput"
                                width="100%"
                                placeholder="Type PO number"
                                value="{outgoingEntryMethod>/poNumber}"
                                showSuggestion="true"
                                suggestionItems="{outgoingPoSuggest>/items}"
                                suggest=".onOutgoingDialogPoSuggest"
                                suggestionItemSelected=".onOutgoingDialogPoSuggestionSelected"
                                class="sapUiTinyMarginEnd plmsRvFieldGrow plmsRvScanInput"
                            >
                                <suggestionItems>
                                    <SuggestionItem
                                        text="{outgoingPoSuggest>Ebeln}"
                                        description="{outgoingPoSuggest>VendorName}"
                                    />
                                </suggestionItems>
                            </Input>
                            <CheckBox
                                id="idOutgoingSkipDocumentPo"
                                text="Skip Document"
                                selected="{outgoingEntryMethod>/skipDocumentPo}"
                                class="plmsRvCheckbox"
                            />
                        </HBox>
                    </content>
                </Panel>

                <!-- Success Text -->
                <Text
                    text="Trip created. Press Continue to open it."
                    visible="{= ${incomingEntryMethod>/entryComplete} }"
                />

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Cancel"
                press=".onCancelIncomingEntryMethodDialog"
            />
        </beginButton>

        <endButton>
            <Button
                text="Continue"
                type="Emphasized"
                press=".onContinueReportVehicleCombinedDialog"
            />
        </endButton>

    </Dialog>
</core:FragmentDefinition>