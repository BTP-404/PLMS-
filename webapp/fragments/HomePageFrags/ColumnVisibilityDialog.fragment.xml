<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="columnVisibilityDialog"
        title="Column Settings"
        contentWidth="300px"
    >
        <content>
            <List
                items="{
                    path: 'columnSettings>/columns'
                }"
            >
                <CustomListItem>
                    <HBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                    >
                        <Text text="{columnSettings>label}" />
                        <Switch
                            state="{columnSettings>visible}"
                            change=".onColumnSwitchChanged"
                        />
                    </HBox>
                </CustomListItem>
            </List>
        </content>
        <beginButton>
            <Button
                text="Reset"
                press=".onResetColumnVisibility"
            />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseColumnVisibilityDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

