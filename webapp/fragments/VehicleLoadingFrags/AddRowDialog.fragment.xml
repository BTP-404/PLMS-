<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="idAddRowDialog"
        title="Add Material Row"
        class="sapUiResponsivePadding--content"
        contentWidth="32rem">

        <form:SimpleForm
            id="idAddRowSimpleForm"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanL="4"
            labelSpanM="4"
            adjustLabelSpan="false"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1">

            <Label text="Ref Doc Number"/>
            <Input id="idDialogRefDocNo" valueLiveUpdate="true" />

            <Label text="Ref Doc Item Number"/>
            <Input id="idDialogRefDocItem" valueLiveUpdate="true" />

            <Label text="Material Code"/>
            <Input id="idDialogMaterialCode" valueLiveUpdate="true" />

            <Label text="Material Description"/>
            <Input id="idDialogMaterialDesc" valueLiveUpdate="true" />

            <Label text="Qty"/>
            <Input id="idDialogQty" type="Number" valueLiveUpdate="true" />

            <Label text="UoM"/>
            <Select id="idDialogUoM">
                <core:Item key="KG" text="KG"/>
                <core:Item key="TON" text="TON"/>
            </Select>

            <Label text="Loaded Qty / Net Wt"/>
            <Input id="idDialogLoadedQty" valueLiveUpdate="true" />

            <Label text="Gross Wt"/>
            <Input id="idDialogGrossWt" valueLiveUpdate="true" />

            <Label text="Tare Wt"/>
            <Input id="idDialogTareWt" valueLiveUpdate="true" />

        </form:SimpleForm>

        <beginButton>
            <Button
                text="Add"
                type="Emphasized"
                press=".onAddRow"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelAddRow"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>
