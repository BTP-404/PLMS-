<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="entryGateDialog"
        title="Select Entry Gate"
        contentWidth="25rem"
        items="{
            path: 'helpModel>/'
        }"
        confirm="onEntryGateValueHelpConfirm"
        search="onEntryGateValueHelpSearch"
        liveChange="onEntryGateValueHelpSearch"
    >
        <StandardListItem
            title="{helpModel>ConfigID}"
            description="{helpModel>Description}"
        />
    </SelectDialog>
</core:FragmentDefinition>
