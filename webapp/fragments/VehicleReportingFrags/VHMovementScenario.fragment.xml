<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="idVHMovementScenario"
        title="Select Movement Scenario"
        contentWidth="40%"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">

            <SearchField
                id="idSearchMovementScenario"
                width="100%"
                liveChange="onSearchVHMovementScenario" />

            <List
                id="idVHMovementScenarioList"
                mode="SingleSelectMaster"
                selectionChange="onSelectMovementScenario" />
        </VBox>

        <endButton>
            <Button text="Cancel" press="onCancelVH"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
