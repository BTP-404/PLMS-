<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <Dialog
        id="idVHVehicleType"
        title="Select Vehicle Type"
        contentWidth="40%"
        contentHeight="60%"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">
            <SearchField width="100%" liveChange="onSearchVehicleType" search="onSearchVehicleType"/>

           <List
                id="idVHVehicleTypeList"
                mode="SingleSelectMaster"
                items="{ 
                    path: 'VHModel>/' 
                }"
                selectionChange="onConfirmVH">

                <StandardListItem
                    title="{VHModel>Description}"
                    description="{VHModel>ConfigID}"
                    type="Active"/>
            </List>
        </VBox>

        <endButton>
            <Button text="Cancel" press="onCancelVH"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>

