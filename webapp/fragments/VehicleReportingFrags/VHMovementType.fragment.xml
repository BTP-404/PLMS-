<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="idVHMovementType"
        title="Select Movement Type"
        contentWidth="40%"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">
            <SearchField
                width="100%"
                liveChange="onSearchVH" />

            <List
                id="idVHMovementTypeList"
                mode="SingleSelectMaster"
                items="{
                    path: '/MovementTypeSet'
                }"
                selectionChange="onConfirmVH">

                <StandardListItem
                    title="{MovementType}"
                    description="{MovementDesc}"
                    info="{MovementCategory}"
                    type="Active" />
            </List>
        </VBox>

        <endButton>
            <Button text="Cancel" press="onCancelVH" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>
