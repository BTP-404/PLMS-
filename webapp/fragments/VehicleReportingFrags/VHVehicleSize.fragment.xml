<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

    <Dialog
        id="idVHVehicleSize"
        title="Select Vehicle Size"
        contentWidth="40%"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">
            <SearchField width="100%" liveChange="onSearchVH"/>

            <List
                id="idVHVehicleSizeList"
                mode="SingleSelectMaster"
                items="{ path: '/VehicleSizeSet' }"
                selectionChange="onConfirmVH">

                <StandardListItem
                    title="{VehicleSize}"
                    description="{VehicleSizeDesc}"
                    type="Active"/>
            </List>
        </VBox>

        <endButton>
            <Button text="Cancel" press="onCancelVH"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
