<core:FragmentDefinition 
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="idVHCompanyCode"
        title="Select Company Code"
        contentWidth="40%"
        contentHeight="60%"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">

            <!-- Search -->
            <SearchField 
                width="100%" 
                liveChange="onSearchCompanyCode"/>

            <!-- List -->
            <List
                id="idVHCompanyCodeList"
                mode="SingleSelectMaster"
                items="{ 
                    path: 'VHModel>/' 
                }"
                selectionChange="onSelectCompanyCode">

                <StandardListItem
                    title="{VHModel>ConfigID}"
                    description="{VHModel>Description}"
                    type="Active"/>
            </List>

        </VBox>

        <endButton>
            <Button text="Cancel" press="onCancelVH"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
