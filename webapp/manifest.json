{
    "_version": "1.7.0",
    "sap.app": {
        "id": "com.incresolZ_INC_PLMS",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "sourceTemplate": {
            "id": "servicecatalog.connectivityComponent",
            "version": "0.0.0",
            "toolsId": "4034a1d2-20c7-46da-85de-5d9f2a0c7f16"
        },
        "dataSources": {
            "YIGP_PLMS_SRV": {
                "uri": "/sap/opu/odata/sap/YIGP_PLMS_SRV/",
                "type": "OData",
                "settings": {
                    "odataVersion": "2.0",
                    "localUri": "localService/metadata.xml"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        },
        "supportedThemes": [
            "sap_hcb",
            "sap_belize",
            "sap_fiori_3",
            "sap_fiori_3_hcb",
            "sap_fiori_3_hcw"
        ]
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "com.incresolZ_INC_PLMS.view.App",
            "type": "XML"
        },
        "dependencies": {
            "minUI5Version": "1.30.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {},
                "sap.f": {},
                "sap.ui.layout": {},
                "sap.ushell": {},
                "sap.collaboration": {},
                "sap.ui.comp": {},
                "sap.uxap": {},
                "sap.ndc": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "com.incresolZ_INC_PLMS.i18n.i18n"
                }
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "viewPath": "com.incresolZ_INC_PLMS.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "transition": "slide"
            },
            "routes": [
                {
                    "pattern": "",
                    "name": "HomePage",
                    "target": "HomePage"
                },
                {
                    "pattern": "Stage",
                    "name": "Stage",
                    "target": "Stage"
                },
                {
                    "pattern": "Stage/{tripNo}",
                    "name": "StagewithParam",
                    "target": "Stage"
                }
            ],
            "targets": {
                "HomePage": {
                    "viewName": "HomePage",
                    "viewLevel": 1
                },
                "Stage": {
                    "viewName": "Stage",
                    "viewLevel": 2
                }
            }
        }
    }
}