<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns:unified="sap.ui.unified" controllerName="com.incresolZ_INC_PLMS.controller.Stage"
>
	<VBox class="sapUiSmallMargin">
		<!-- Reporting Details Panel -->
		<Panel id="reportingDetailsPanel" headerText="Reporting Details" expandable="true" expanded="true" class="sapUiSmallMargin">
			<form:SimpleForm id="reportingDetailsForm" editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="1"
				emptySpanM="1" columnsL="2" columnsM="2" columnsS="1">
				<!-- Mandatory fields -->
				<Label text="Movement Scenario" required="true"/>
				<Select id="idMovementScenario" required="true"/>
				<Label text="Movement Type" required="true"/>
				<Select id="idMovementType" required="true"/>
				<Label text="Vehicle Number" required="true"/>
				<Input id="idVehicleNumber" required="true"/>
				<Label text="Vehicle Type" required="true"/>
				<Select id="idVehicleType" required="true"/>
				<Label text="Vehicle Size" required="true"/>
				<Select id="idVehicleSize" required="true"/>
				<Label text="Transporter Name" required="true"/>
				<Input id="idTransporterName" required="true"/>
				<!-- Non-mandatory fields -->
				<Label text="LR Number"/>
				<Input id="idLRNumber"/>
				<Label text="LR Date"/>
				<DatePicker id="idLRDate"/>
				<Label text="Driver Name" required="true"/>
				<Input id="idDriverName" required="true"/>
				<Label text="Driver Contact" required="true"/>
				<Input id="idDriverContact" required="true"/>
				<Label text="Driver License" required="true"/>
				<Input id="idDriverLicense" required="true"/>
				<Label text="Driver Photo"/>
				<unified:FileUploader id="idDriverPhoto" uploadUrl="/upload" buttonText="Browse" fileType="jpg,png" placeholder="Upload Driver Photo"  change="onDriverPhotoChange"/>
				<Label text="Additional Info"/>
				<TextArea id="idAdditionalInfo"/>
				<Label text="Company Code" required="true"/>
				<Select id="idCompanyCode" required="true"/>
				<Label text="Plant" required="true"/>
				<Select id="idPlant" required="true"/>
				<Label text="Related Trip Number"/>
				<Input id="idRelatedTripNumber"/>
			</form:SimpleForm>
			<!-- Action Buttons (Edit + Save) -->
			<HBox id="reportingButtonsBox" justifyContent="End" class="sapUiSmallMarginTop sapUiTinyMarginEnd">
				<Button id="btnEditReporting" text="Edit" type="Emphasized" press="onEditReporting"/>
				<Button id="btnSaveReporting" text="Save" type="Accept" press="onSaveReporting" class="sapUiTinyMarginBegin"/>
			</HBox>
		</Panel>
		<!-- Change History Panel -->
		<Panel id="changeHistoryPanel" headerText="Change History" expandable="true" expanded="false" class="sapUiSmallMargin">
			<form:SimpleForm id="changeHistoryForm" editable="false" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="1"
				emptySpanM="1" columnsL="2" columnsM="2" columnsS="1">
				<Label text="Created By" required="true"/>
				<Select id="idCreatedBy" required="true"/>
				<Label text="Created On Date" required="true"/>
				<DatePicker id="idCreatedOnDate" required="true"/>
				<Label text="Created On Time" required="true"/>
				<TimePicker id="idCreatedOnTime" required="true"/>
				<Label text="Changed By"/>
				<Select id="idChangedBy"/>
				<Label text="Changed On Date"/>
				<DatePicker id="idChangedOnDate"/>
				<Label text="Changed On Time"/>
				<TimePicker id="idChangedOnTime"/>
				<Label text="Completed On Date"/>
				<DatePicker id="idCompletedOnDate"/>
				<Label text="Completed On Time"/>
				<TimePicker id="idCompletedOnTime"/>
			</form:SimpleForm>
			<!-- Action Buttons (Edit + Save) -->
			<HBox id="changeHistoryButtonsBox" justifyContent="End" class="sapUiSmallMarginTop sapUiTinyMarginEnd">
				<Button id="btnEditHistory" text="Edit" type="Emphasized" press="onEditHistory"/>
				<Button id="btnSaveHistory" text="Save" type="Accept" press="onSaveHistory" class="sapUiTinyMarginBegin"/>
			</HBox>
		</Panel>
	</VBox>
</mvc:View>